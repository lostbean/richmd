#!/usr/bin/env bash
#
# gate-stamp-check — schema-version-freshness gate for a TARGET repo's
# copy-installed check scripts and schema copy (schema
# scripts_contract.distribution). The version is single-sourced from the
# schema.json "version" field, in exactly one place on each side: the
# framework's schema/design-schema.json and the host's copy at
# scripts/design-schema.json. Scripts carry NO per-script version stamp —
# the old per-script schema-version header stamp and the older
# design-render-build hash are both retired.
#
# Two checks, fail closed:
#
#   (a) every copy-installed check script (layer-integrity, gate-stamp-check,
#       richmd-project) exists in <target>/scripts/. A missing one is a
#       violation, never a skip. There is no per-script stamp to check.
#   (b) the host's copy-installed <target>/scripts/design-schema.json exists
#       and its "version" equals the framework schema's "version". A lower
#       host version is a stale install: the host runs an older gate, behind
#       the framework. It is reported as a violation naming both versions;
#       the CALLER (sync, setup-project-skills) decides whether to warn-and-
#       offer re-install or block. This script only reports and exits.
#
# Usage: gate-stamp-check <target-repo> [framework-root]
#   framework-root defaults to this script's own repo (<script-dir>/..);
#   pass it explicitly when running a copy-installed instance of this script.
#
# Self-contained mode: when NO framework-root argument is given and the
# default (<script-dir>/..) carries no schema/design-schema.json — the
# copy-installed layout with no framework checkout in reach — there is
# nothing to compare AGAINST. That is not an error: an explicit notice and
# exit 0. An explicit framework-root that does not resolve stays exit 2.
#
# Exit 0: versions equal (one OK line), or self-contained mode (notice).
# Exit 1: at least one violation (one report line per finding) — a missing
# copy-installed script, a missing host schema copy, or a host version lower
# than the framework version. Exit 2: usage/IO error (bad args, target repo
# not found, unreadable framework or host schema).
set -euo pipefail

usage() {
  echo "usage: $(basename "$0") <target-repo> [framework-root]" >&2
}

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
  usage
  exit 2
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "error: python3 is required (used for schema parsing)" >&2
  exit 2
fi

TARGET_ARG="$1"
if [ ! -d "$TARGET_ARG" ]; then
  echo "error: target repo not found: $TARGET_ARG" >&2
  exit 2
fi
TARGET="$(cd "$TARGET_ARG" && pwd -P)"

EXPLICIT_FRAMEWORK=0
if [ "$#" -eq 2 ]; then
  FRAMEWORK_ARG="$2"
  EXPLICIT_FRAMEWORK=1
else
  SELF="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$0")"
  FRAMEWORK_ARG="$(dirname "$SELF")/.."
fi
# Self-contained mode (see header): the default framework root is not a
# framework checkout, and no explicit root was passed — skip, do not fail.
if [ "$EXPLICIT_FRAMEWORK" -eq 0 ] &&
  { [ ! -d "$FRAMEWORK_ARG" ] || [ ! -f "$FRAMEWORK_ARG/schema/design-schema.json" ]; }; then
  echo "gate-stamp-check: framework not reachable (no schema/design-schema.json under $FRAMEWORK_ARG); version check skipped (self-contained mode)"
  exit 0
fi
if [ ! -d "$FRAMEWORK_ARG" ]; then
  echo "error: framework root not found: $FRAMEWORK_ARG" >&2
  exit 2
fi
FRAMEWORK="$(cd "$FRAMEWORK_ARG" && pwd -P)"

# --- Framework truth: schema version -----------------------------------------

FW_SCHEMA="$FRAMEWORK/schema/design-schema.json"
if [ ! -f "$FW_SCHEMA" ]; then
  echo "error: framework schema not found: $FW_SCHEMA" >&2
  exit 2
fi
if ! FW_VERSION="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["version"])' "$FW_SCHEMA")"; then
  echo "error: cannot read \"version\" from framework schema: $FW_SCHEMA" >&2
  exit 2
fi

# --- Target checks, fail closed ----------------------------------------------

CHECK_SCRIPTS=(layer-integrity gate-stamp-check richmd-project)

found=0
violation() { # <file> <why>
  printf 'violation: %s: %s\n' "$1" "$2"
  found=1
}

# Every copy-installed check script must exist. There is no per-script stamp
# to check anymore — the version lives only in the schema copy (checked next).
for name in "${CHECK_SCRIPTS[@]}"; do
  f="$TARGET/scripts/$name"
  if [ ! -f "$f" ]; then
    violation "scripts/$name" "missing copy-installed check script (re-run setup-project-skills)"
  fi
done

# The version is single-sourced from the host's copy of the schema. A missing
# copy is a violation; a lower version is a stale install (re-run setup).
HOST_SCHEMA="$TARGET/scripts/design-schema.json"
if [ ! -f "$HOST_SCHEMA" ]; then
  violation "scripts/design-schema.json" "missing copy-installed schema (re-run setup-project-skills)"
elif ! HOST_VERSION="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["version"])' "$HOST_SCHEMA")"; then
  violation "scripts/design-schema.json" 'cannot read "version" from copy-installed schema'
elif [ "$HOST_VERSION" -lt "$FW_VERSION" ]; then
  violation "scripts/design-schema.json" "stale install: host schema version is $HOST_VERSION, framework schema is $FW_VERSION — re-run setup-project-skills to re-install"
elif [ "$HOST_VERSION" -gt "$FW_VERSION" ]; then
  violation "scripts/design-schema.json" "host schema version $HOST_VERSION is ahead of the framework schema $FW_VERSION (framework checkout is behind?)"
fi

# --- Verdict -------------------------------------------------------------------

if [ "$found" -ne 0 ]; then
  exit 1
fi
echo "gate-stamp-check OK: schema v$FW_VERSION — host install current in $TARGET"
exit 0
