    .richmd-group--principle { border-left-color: var(--fw-tint-violet-edge); } .richmd-group--principle > h3 { color: var(--fw-tint-violet-fg); }
    /* foundation cards STACK one-per-row (mockup), not a 3-col grid — richmd's
       card-grid defaults to repeat(3,1fr); force a single column. */
    .richmd-group .richmd-card-grid { grid-template-columns: 1fr; }

    /* card proportions + tint per foundation kind (richmd emits .richmd-card--goal etc.) */
    .richmd-card { border-radius: 12px; padding: var(--richmd-space-4); box-shadow: 0 1px 2px rgba(20,24,31,0.04); gap: var(--richmd-space-2); }
    /* card title: mockup is Inter 15/700, NOT richmd's Fraunces 19/500 */
    .richmd-card-title, .richmd-card-title strong {
      font-family: var(--richmd-font-body); font-weight: 700; font-size: 15px; line-height: 1.25;
    }
    /* card body: mockup 13px */
    .richmd-card-body, .richmd-card-body p { font-size: 13px; line-height: 1.55; }
    .richmd-card--goal      { background: var(--fw-tint-teal-bg);   border-left: 3px solid var(--fw-tint-teal-edge);   } .richmd-card--goal .richmd-card-title { color: var(--fw-tint-teal-fg); }
    .richmd-card--no-goal   { background: var(--fw-tint-rose-bg);   border-left: 3px solid var(--fw-tint-rose-edge);   } .richmd-card--no-goal .richmd-card-title { color: var(--fw-tint-rose-fg); }
    .richmd-card--invariant { background: var(--fw-tint-amber-bg);  border-left: 3px solid var(--fw-tint-amber-edge);  } .richmd-card--invariant .richmd-card-title { color: var(--fw-tint-amber-fg); }
    .richmd-card--principle { background: var(--fw-tint-violet-bg); border-left: 3px solid var(--fw-tint-violet-edge); } .richmd-card--principle .richmd-card-title { color: var(--fw-tint-violet-fg); }

    /* --- callouts, diagrams, tables, details, stat tiles: mockup radii + tighter type --- */
    .richmd-diagram, .richmd-callout, .richmd-toc, .richmd-details, .richmd-table-wrap { border-radius: 12px; }

    /* --- WIDGET DETAIL PARITY (measured field-by-field against the mockup) --- */
    /* stat tile: 12px radius (richmd base 10), label 11px. richmd's stat-tile
       now emits richmd-stat-delta--up / --down from the dir= attr (richmd
       60bffba), so tint the delta BY DIRECTION: up=teal, down=danger/rose —
       the workaround of one flat color is gone. */
    .richmd-stat { border-radius: 12px; }
    .richmd-stat-label { font-size: 11px; }
    .richmd-stat-delta--up   { color: var(--fw-tint-teal-fg); }
    .richmd-stat-delta--down { color: var(--fw-tint-rose-fg); }
    /* callout: richmd sets .richmd-callout-body color to ink, overriding the
       root's tint. Re-tint body text per callout kind so title+body read in
       the tint (mockup behavior). */
    .richmd-callout--info .richmd-callout-body    { color: var(--fw-tint-blue-fg); }
    .richmd-callout--warning .richmd-callout-body { color: var(--fw-tint-amber-fg); }
    .richmd-callout--danger .richmd-callout-body  { color: var(--fw-tint-rose-fg); }
    .richmd-callout .richmd-callout-body strong { color: inherit; }
    /* TITLE ABOVE, BODY BELOW (mockup). Two authoring shapes both land here:
       (a) `.callout` written as two paragraphs — the FIRST body <p> is the
           title (bold, block); following <p> is the body.
       (b) `:::info` emits a .richmd-callout-title element — block, above. */
    .richmd-callout-body > p:first-child > strong:only-child,
    .richmd-callout-body > p:first-child:has(> strong:only-child) {
      display: block; font-weight: 700; margin: 0 0 var(--richmd-space-1);
    }
    .richmd-callout-title {
      display: block; font-weight: 700; margin: 0 0 var(--richmd-space-1);
    }
    .richmd-callout-body > p { margin: 0; }
    .richmd-callout-body > p + p { margin-top: var(--richmd-space-1); }
    /* lens pill: mockup is 10px / 700 / UPPERCASE / tight pad (richmd base badge is 12/600/none) */
    .richmd-badge[class*="--lens-"] {
      font-size: 10px; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.04em; padding: 1px 8px;
    }
    /* hide the principle id chip (P1/P2/…): it is the FIRST badge in a
       principle's card-meta (the lens pill follows it). Targeting :first-child
       keeps lens pills and invariant enforcement chips untouched. */
    .richmd-card--principle .richmd-card-meta > .richmd-badge:first-child {
      display: none;
    }
    /* table header + body: mockup 11px / 13.5px (richmd base 12 / text-base) */
    .richmd-doc th { font-size: 11px; }
    .richmd-doc td { font-size: 13.5px; }
    /* inline code: mockup is 12px muted weight 400. richmd base uses 0.87em
       which inflates when an ancestor bumps the em (observed 15-16px); pin an
       ABSOLUTE 12px so it's stable regardless of parent size. */
    .richmd-doc code { font-weight: 400; font-size: 12px; color: var(--richmd-color-text-faint); }
    /* code inside a code block stays full size / ink (it's not inline chrome) */
    .richmd-doc pre code { font-size: 13px; color: var(--richmd-color-text); }
    /* SVG figure (:::embedded-svg) — richmd emits
       <figure><div.richmd-embedded-svg><svg/></div><figcaption/></figure>.
       Frame the FIGURE (so the caption is inside the card too), center the svg,
       mute the caption. Matches the mockup .figure. */
    figure:has(> .richmd-embedded-svg) {
      text-align: center; margin: var(--richmd-space-4) 0;
      background: var(--richmd-color-surface);
      border: 1px solid var(--richmd-color-border);
      border-radius: 12px; padding: var(--richmd-space-5);
    }
    .richmd-embedded-svg svg { max-width: 200px; display: inline-block; }
    figure:has(> .richmd-embedded-svg) figcaption {
      font-size: 12px; color: var(--richmd-color-text-faint); margin-top: var(--richmd-space-3);
    }
    /* details/disclosure body: richmd leaves the body flush with no inset.
       Inset it to match the mockup .disc-body (padding around the content). */
    .richmd-details > summary { padding: var(--richmd-space-3) var(--richmd-space-4); }
    .richmd-details > *:not(summary) {
      margin: 0; padding: 0 var(--richmd-space-4) var(--richmd-space-4);
      font-size: 13.5px; color: var(--richmd-color-text-muted);
    }
    /* --- CALLOUT ICON: richmd's theme styles .richmd-callout-icon but callout.lua
       never emits one (styled-but-empty slot). Inject a per-tint SVG icon as a
       ::before so it matches the mockup: info=circle-i, warning=triangle-!,
       danger=circle-x. Colored via the callout's own currentColor. --- */
    .richmd-callout { align-items: flex-start; }
    .richmd-callout::before {
      content: ""; flex: none; width: 18px; height: 18px; margin-top: 2px;
      background: currentColor; -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
      -webkit-mask-position: center; mask-position: center;
      -webkit-mask-size: contain; mask-size: contain;
    }
    .richmd-callout--info::before {
      -webkit-mask-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><circle cx="10" cy="10" r="9" fill="none" stroke="black" stroke-width="1.6"/><rect x="9" y="8.5" width="2" height="6" rx="1"/><circle cx="10" cy="5.5" r="1.2"/></svg>');
      mask-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><circle cx="10" cy="10" r="9" fill="none" stroke="black" stroke-width="1.6"/><rect x="9" y="8.5" width="2" height="6" rx="1"/><circle cx="10" cy="5.5" r="1.2"/></svg>');
    }
    .richmd-callout--warning::before {
      -webkit-mask-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M10 2 L19 18 H1 Z" fill="none" stroke="black" stroke-width="1.6" stroke-linejoin="round"/><rect x="9" y="8" width="2" height="5" rx="1"/><circle cx="10" cy="15" r="1.1"/></svg>');
      mask-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M10 2 L19 18 H1 Z" fill="none" stroke="black" stroke-width="1.6" stroke-linejoin="round"/><rect x="9" y="8" width="2" height="5" rx="1"/><circle cx="10" cy="15" r="1.1"/></svg>');
    }
    .richmd-callout--danger::before {
      -webkit-mask-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><circle cx="10" cy="10" r="9" fill="none" stroke="black" stroke-width="1.6"/><path d="M6.5 6.5 L13.5 13.5 M13.5 6.5 L6.5 13.5" stroke="black" stroke-width="1.6"/></svg>');
      mask-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><circle cx="10" cy="10" r="9" fill="none" stroke="black" stroke-width="1.6"/><path d="M6.5 6.5 L13.5 13.5 M13.5 6.5 L6.5 13.5" stroke="black" stroke-width="1.6"/></svg>');
    }
    /* stat value: mockup 34px (richmd base is 39px / --richmd-text-3xl) */
    .richmd-stat-value { font-family: var(--richmd-font-heading); font-weight: 500; font-size: 34px; font-variation-settings: "opsz" 40; }
    .richmd-diagram-title { font-size: 11px; letter-spacing: 0.08em; }
    /* section lede/intro prose under each h2: mockup is 14px muted, not 16px ink */
    .richmd-container h2 + p { font-size: 14px; color: var(--richmd-color-text-muted); margin-top: var(--richmd-space-2); }
    /* the doc-level intro paragraph (after the H1 hero): keep as lede size, muted */
    .richmd-container > p { color: var(--richmd-color-text-muted); }

    /* --- PENDING-LEDGER: the TYPED-STATEMENT vertical pattern (title → break →
       meta [pill + since on one line] → break → description). Dashed tinted
       card. Mirrors goal/invariant/principle rhythm. --- */
    .richmd-pending {
      border: 1px dashed var(--richmd-color-border-strong); border-radius: 12px;
      padding: var(--richmd-space-4) var(--richmd-space-5);
      background: var(--richmd-color-bg-alt);
      margin: var(--richmd-space-3) 0;
    }
    .richmd-pending-title {
      font-family: var(--richmd-font-body); font-weight: 700; font-size: 15px;
      line-height: 1.25; margin: 0 0 var(--richmd-space-2);
    }
    /* meta row: kind pill + since date on ONE line */
    .richmd-pending-meta {
      display: flex; align-items: center; gap: var(--richmd-space-3);
      margin: 0 0 var(--richmd-space-2);
    }
    .richmd-pending-meta:last-child { margin-bottom: 0; }
    .richmd-pending-meta > .richmd-badge {
      border-radius: 999px; text-transform: none; letter-spacing: normal;
      font-family: var(--richmd-font-mono); font-size: 11px; font-weight: 600; padding: 2px 9px;
    }
    .richmd-pending-body { font-size: 13.5px; color: var(--richmd-color-text-muted); }
    .richmd-pending-body > p { margin: 0; }
    /* the per-kind pending pill AND the per-kind entry edge are emitted from
       the schema's pending kinds — see the _PENDING_TINT loop in the overlay
       builder, so a new kind reprojects instead of needing a hand-edit here. */
    .richmd-pending-since {
      color: var(--richmd-color-text-faint);
      font-family: var(--richmd-font-mono); font-size: 11px; white-space: nowrap;
    }

    @media (max-width: 820px) {
      .richmd-hero-grid { grid-template-columns: 1fr; }
      .richmd-hero-grid h1 { font-size: 40px; }
    }
  
"""


def build_overlay_css():
    L = []
    L.append("/* Framework semantic-look overlay — projected by "
             "scripts/richmd-project (ADR-0024). */")
    L.append("/* richmd owns the base look; this overlay owns the per-kind "
             "accent, per-lens */")
    L.append("/* pill palette, and card tints — the design's own vocabulary. "
             "It overrides */")
    L.append("/* cleanly: any base property it takes over is reset then "
             "restyled. */")
    # --- palette variables (light) ---
    L.append("    .richmd-doc {")
    L.extend(_lens_vars(False))
    L.extend(_enf_vars(False))
    L.extend(_tint_vars(False))
    L.extend(_clause_ink_vars(False))
    L.extend(_level_vars(False))
    L.extend(_behavior_ground_var(False))
    L.append("    }")
    # --- palette variables (dark) ---
    # richmd (upstream) always mirrors the RESOLVED theme onto
    # .richmd-doc[data-richmd-theme] (OS-driven or explicit), so the --fw-* dark
    # values are keyed on the ATTRIBUTE — not just @media — otherwise forcing or
    # toggling the theme desyncs the --fw-* tints from the --richmd-color-*
    # tokens (a card stays light-tinted on a dark page). Emit BOTH: the media
    # query (guarded so a forced-light doc opts out) AND the explicit attribute
    # selector.
    dark_var_lines = (
        ["  " + l for l in _lens_vars(True)]
        + ["  " + l for l in _enf_vars(True)]
        + ["  " + l for l in _tint_vars(True)]
        + ["  " + l for l in _clause_ink_vars(True)]
        + ["  " + l for l in _level_vars(True)]
        + ["  " + l for l in _behavior_ground_var(True)]
    )
    L.append("    @media (prefers-color-scheme: dark) {")
    L.append("      .richmd-doc:not([data-richmd-theme=\"light\"]) {")
    L.extend(dark_var_lines)
    L.append("      }")
    L.append("    }")
    L.append("    .richmd-doc[data-richmd-theme=\"dark\"] {")
    for l in dark_var_lines:
        L.append(l[2:])  # one less indent level (not nested in @media)
    L.append("    }")
    # --- per-lens pill palette ---
    for name in lens_values:
        L.append("    .richmd-badge--lens-%s {" % name)
        L.append("      background: var(--fw-lens-%s-bg);" % name)
        L.append("      color: var(--fw-lens-%s-fg);" % name)
        L.append("    }")
    # --- enforcement chip: per-value tone (the truthfulness scale) ---
    # richmd's base .richmd-badge--neutral is a flat grey chip. The invariant
    # renderer adds a per-value richmd-badge--enf-<value> modifier; the overlay
    # gives each enforcement value (mechanism/partial/convention) its own tone,
    # so the chip reads the enforcement scale rather than uniform grey. Keyed on
    # the enf modifier so it wins over the base --neutral cleanly.
    for name in enforcement_values:
        L.append("    .richmd-badge--enf-%s {" % name)
        L.append("      background: var(--fw-enf-%s-bg);" % name)
        L.append("      color: var(--fw-enf-%s-fg);" % name)
        L.append("    }")
    # --- per-kind statement accent — RESET richmd's base, then restyle. ---
    # richmd base: .richmd-statement { display:grid; grid-template-columns:
    # 160px 1fr; padding; border-top }. The overlay replaces the top border with
    # a per-kind left edge and a surface, so it RESETS border-top and padding
    # first (clean override — no stacked border), keeping the base grid.
    L.append("    .richmd-statement {")
    L.append("      border-top: none;")
    L.append("      border-left: 3px solid var(--fw-tint-slate-edge);")
    L.append("      padding: var(--richmd-space-3) var(--richmd-space-4);")
    L.append("      border-radius: var(--richmd-radius-md);")
    L.append("      margin: var(--richmd-space-2) 0;")
    L.append("    }")
    L.append("    .richmd-statement:first-of-type {")
    L.append("      border-top: none;")
    L.append("    }")
    for name in foundation_kinds + [k for k in _ACCENTED_KINDS if k in declared_blocks]:
        L.append("    .richmd-statement--%s {" % name)
        L.append("      border-left-color: %s;" % ("var(--fw-tint-%s-edge)" % _KIND_TINT[name]
                                                   if name in _KIND_TINT else "var(--fw-tint-slate-edge)"))
        L.append("    }")
    # --- behavior clause layout — the keyword gutter (ADR-0024 overlay). ---
    # A behavior block's body is its clause blocks, which richmd's base leaves
    # as bare stacked Divs: no gutter, no separation, so the rule reads as one
    # run-on mass. Each clause becomes a two-column row — a fixed right-aligned
    # keyword gutter, then the clause text in its own column — with the rows
    # separated vertically and the text column padded away from the gutter, so
    # the text reads as its own block. The keywords align into a column, making
    # the rule's shape (how many outcomes) visible before any word is read.
    # A behavior block's body is its clauses, which must stack one per ROW.
    # richmd's base .richmd-statement is `display: grid` with a 160px label
    # column, so without this reset the clauses flow into that two-column grid
    # side by side and each clause's text is squeezed into ~160px, wrapping one
    # word per line. The behavior statement therefore drops to a single column;
    # its own head row keeps the title-plus-badges line.
    L.append("    .richmd-statement--behavior {")
    L.append("      display: block;")
    # the whole rule carries its kind's ground, not only a left edge, so a
    # behavior rule is identifiable as one filled card in a page of prose.
    L.append("      background: var(--fw-behavior-bg);")
    L.append("    }")
    # the head row: badges lead, the title follows, with real space between
    # them so the chip reads as a separate label rather than crowding the
    # title. flex keeps them on one line and vertically centred; wrap lets a
    # long title fall to the next line without pushing the chip off the row.
    L.append("    .richmd-statement--behavior > .richmd-statement-label {")
    L.append("      display: flex;")
    L.append("      flex-wrap: wrap;")
    L.append("      align-items: center;")
    L.append("      gap: 0 var(--richmd-space-3);")
    L.append("      margin-bottom: var(--richmd-space-3);")
    L.append("    }")
    L.append("    .richmd-clause {")
    L.append("      display: grid;")
    L.append("      grid-template-columns: 4.5rem minmax(0, 1fr);")
    L.append("      gap: 0 var(--richmd-space-3);")
    L.append("      margin: var(--richmd-space-2) 0;")
    L.append("      align-items: baseline;")
    L.append("    }")
    L.append("    .richmd-clause + .richmd-clause {")
    L.append("      margin-top: var(--richmd-space-2);")
    L.append("    }")
    L.append("    .richmd-clause > .richmd-clause-keyword {")
    L.append("      text-align: right;")
    L.append("      font-size: 10px;")
    L.append("      font-weight: 700;")
    L.append("      text-transform: uppercase;")
    L.append("      letter-spacing: 0.06em;")
    L.append("      color: var(--fw-tint-slate-fg);")
    L.append("    }")
    # the clause text column: separated from the gutter by a quiet rule, so the
    # prose reads as a distinct block rather than continuing the keyword row.
    L.append("    .richmd-clause > :not(.richmd-clause-keyword) {")
    L.append("      margin: 0;")
    L.append("      padding-left: var(--richmd-space-3);")
    L.append("      border-left: 1px solid var(--fw-tint-slate-edge);")
    L.append("    }")
    # per-keyword tone — the clause kinds are schema-declared, so a new clause
    # kind reprojects rather than needing a hand-edit here.
    for name in [k for k in _CLAUSE_KIND_ORDER if k in declared_blocks]:
        tint = _CLAUSE_TINT.get(name)
        if not tint:
            continue
        L.append("    .richmd-clause--%s > .richmd-clause-keyword {" % name)
        L.append("      color: var(--fw-clause-%s-ink, var(--fw-tint-%s-fg));"
                 % (name, tint))
        L.append("    }")
        L.append("    .richmd-clause--%s > :not(.richmd-clause-keyword) {" % name)
        L.append("      border-left-color: var(--fw-tint-%s-edge);" % tint)
        L.append("    }")
    # --- per-pending-kind tone: the kind pill AND the entry's dashed edge. ---
    # The pill was already toned; the entry WRAPPER (richmd-pending--<kind>)
    # carried no rule at all, so a pending entry's kind was readable only from
    # its pill. Both are emitted here from the schema's pending kinds.
    for name in pending_kinds:
        tint = _PENDING_TINT.get(name)
        if not tint:
            continue
        L.append("    .richmd-badge--pending-%s {" % name)
        L.append("      background: var(--fw-tint-%s-bg);" % tint)
        L.append("      color: var(--fw-tint-%s-fg);" % tint)
        L.append("    }")
        L.append("    .richmd-pending--%s {" % name)
        L.append("      border-color: var(--fw-tint-%s-edge);" % tint)
        L.append("    }")
    # --- per-level badge tone. ---
    # The `level=` chip carries richmd-badge--neutral (a flat grey), so the two
    # levels rendered identically. Each level takes its own tone, the same
    # treatment an enforcement value already gets.
    # A level reads its own --fw-level-* pair when it has one (interface, whose
    # hue no shared tint supplies), else the shared tint it maps to (boundary).
    for name in behavior_levels:
        if name in _LEVEL_PALETTE:
            bg = "var(--fw-level-%s-bg)" % name
            fg = "var(--fw-level-%s-fg)" % name
        else:
            tint = _LEVEL_TINT.get(name)
            if not tint:
                continue
            bg = "var(--fw-tint-%s-bg)" % tint
            fg = "var(--fw-tint-%s-fg)" % tint
        L.append("    .richmd-badge--level-%s {" % name)
        L.append("      background: %s;" % bg)
        L.append("      color: %s;" % fg)
        L.append("    }")
    # --- card tint — RESET richmd's base card border/background, then restyle. ---
    # richmd base: .richmd-card { background; border; border-radius; padding;
    # box-shadow }. A tinted grid tints each of its cards with a quiet left edge
    # and a matching surface; the overlay RESETS the base border to a left edge
    # so the two borders never stack.
    for name in tint_values:
        L.append("    .richmd-card-grid--%s > .richmd-card {" % name)
        L.append("      border: 1px solid var(--fw-tint-%s-edge);" % name)
        L.append("      border-left: 3px solid var(--fw-tint-%s-edge);" % name)
        L.append("      background: var(--fw-tint-%s-bg);" % name)
        L.append("    }")
        L.append("    .richmd-card-grid--%s > .richmd-card .richmd-card-title {" % name)
        L.append("      color: var(--fw-tint-%s-fg);" % name)
        L.append("    }")
    # --- grouped foundation card sections (ADR-0025 amended). ---
    # The group hook (richmd#27) renders the foundation as titled per-kind card
    # SECTIONS: a `.richmd-group.richmd-group--<kind>` <section> whose <h3> sits
    # over a `.richmd-card-grid` of NATIVE `.richmd-card.richmd-card--<kind>`
    # Divs (the hook RESHAPES each statement into the native card slots, so a
    # foundation card is structurally the same as any :::cards card — no nested
    # statement, one frame). This block frames the section and tones the heading
    # per kind (REUSING the per-kind edge palette above). The per-kind card
    # accent targets the native `.richmd-card--<kind>` directly. No !important
    # (ADR-0024 discipline); the native card is already the single frame.
    L.append("    .richmd-group {")
    L.append("      margin: var(--richmd-space-5) 0;")
    L.append("      padding-left: var(--richmd-space-4);")
    L.append("      border-left: 3px solid var(--fw-tint-slate-edge);")
    L.append("    }")
    L.append("    .richmd-group > h3 {")
    L.append("      margin: 0 0 var(--richmd-space-3);")
    L.append("      font-size: var(--richmd-text-sm);")
    L.append("      text-transform: uppercase;")
    L.append("      letter-spacing: 0.08em;")
    L.append("      color: var(--fw-tint-slate-fg);")
    L.append("    }")
    # per-kind section accent — heading tone + left edge = the kind's paired
    # tint, reusing _KIND_TINT (the same palette the per-kind statement edge
    # uses). foundation_kinds is schema-derived, so a kind change reprojects.
    for name in foundation_kinds:
        edge = ("var(--fw-tint-%s-edge)" % _KIND_TINT[name]
                if name in _KIND_TINT else "var(--fw-tint-slate-edge)")
        fg = ("var(--fw-tint-%s-fg)" % _KIND_TINT[name]
              if name in _KIND_TINT else "var(--fw-tint-slate-fg)")
        L.append("    .richmd-group--%s {" % name)
        L.append("      border-left-color: %s;" % edge)
        L.append("    }")
        L.append("    .richmd-group--%s > h3 {" % name)
        L.append("      color: %s;" % fg)
        L.append("    }")
    # the card grid inside a group: the run's statements reshaped into native
    # cards. The native .richmd-card is already the single frame (richmd's base
    # styles it), so there is NO inner statement to reset — the per-kind accent
    # is a left edge on the native .richmd-card--<kind>, echoing the section
    # accent. foundation_kinds is schema-derived, so a kind change reprojects.
    L.append("    .richmd-group .richmd-card-grid {")
    L.append("      margin: 0;")
    L.append("    }")
    for name in foundation_kinds:
        edge = ("var(--fw-tint-%s-edge)" % _KIND_TINT[name]
                if name in _KIND_TINT else "var(--fw-tint-slate-edge)")
        L.append("    .richmd-card--%s {" % name)
        L.append("      border-left: 3px solid %s;" % edge)
        L.append("    }")
    # --- the "How to read this" legend (ADR-0025). ---
    # A collapsed <details class="richmd-group-legend"> naming the four kinds and
    # the enforcement + lens glyph key, emitted once ahead of the first section.
    # The kind-name pills reuse the per-kind edge palette (schema-derived).
    L.append("    .richmd-group-legend {")
    L.append("      margin: var(--richmd-space-4) 0;")
    L.append("      font-size: var(--richmd-text-sm);")
    L.append("    }")
    L.append("    .richmd-group-legend > summary {")
    L.append("      cursor: pointer;")
    L.append("      font-weight: 600;")
    L.append("      color: var(--fw-tint-slate-fg);")
    L.append("    }")
    L.append("    .richmd-group-legend-body {")
    L.append("      display: grid;")
    L.append("      grid-template-columns: max-content 1fr;")
    L.append("      gap: var(--richmd-space-2) var(--richmd-space-4);")
    L.append("      margin-top: var(--richmd-space-3);")
    L.append("    }")
    L.append("    .richmd-group-legend-term {")
    L.append("      font-weight: 600;")
    L.append("      color: var(--fw-tint-slate-fg);")
    L.append("    }")
    L.append("    .richmd-group-legend-row {")
    L.append("      display: flex;")
    L.append("      flex-wrap: wrap;")
    L.append("      align-items: center;")
    L.append("      gap: var(--richmd-space-2);")
    L.append("    }")
    L.append("    .richmd-group-legend-note {")
    L.append("      color: var(--fw-tint-slate-fg);")
    L.append("    }")
    for name in foundation_kinds:
        bg = ("var(--fw-tint-%s-bg)" % _KIND_TINT[name]
              if name in _KIND_TINT else "var(--fw-tint-slate-bg)")
        fg = ("var(--fw-tint-%s-fg)" % _KIND_TINT[name]
              if name in _KIND_TINT else "var(--fw-tint-slate-fg)")
        L.append("    .richmd-group-legend--%s {" % name)
        L.append("      background: %s;" % bg)
        L.append("      color: %s;" % fg)
        L.append("    }")
    L.append(_PARITY_LOOK_CSS)
    return "\n".join(L) + "\n"


overlay_css = build_overlay_css()


def _style_block_lua(css):
    # emit the overlay as a Lua local `style_block()` returning a
    # pandoc.RawBlock("html", "<style>…</style>"). The CSS is embedded as a Lua
    # long-bracket string ([==[ ... ]==]) so its braces, quotes and newlines
    # need no escaping and the bytes stay stable.
    return (
        "-- style_block() -> the framework semantic-look overlay as a\n"
        "-- pandoc.RawBlock (ADR-0024). Delivered through the shell hook because\n"
        "-- richmd exposes no consumer-stylesheet input; the masthead region\n"
        "-- prepends it ahead of the page chrome. The CSS is SCHEMA-DERIVED\n"
        "-- (per-kind, per-lens, per-tint) — a schema mutation reprojects it.\n"
        "local function style_block()\n"
        "  return pandoc.RawBlock(\n"
        "    \"html\",\n"
        "    \"<style>\\n\" .. [==[\n"
        + css
        + "]==] .. \"</style>\"\n"
        "  )\n"
        "end\n"
    )


# _FONTS_BLOCK_LUA — a Lua local fonts_block() returning a <link> that loads
# Fraunces (the display face) with the opsz optical-size axis. richmd's base
# @import loads Space Grotesk / Inter / JetBrains Mono but NOT Fraunces, so
# --richmd-font-heading:"Fraunces" would fall back to the serif stack without
# this. The masthead prepends it so it loads before first paint.
_FONTS_BLOCK_LUA = (
    "-- fonts_block() -> a <link> loading Fraunces (variable, opsz axis). richmd's\n"
    "-- base @import does not load Fraunces, so the display face needs this.\n"
    "local function fonts_block()\n"
    "  return pandoc.RawBlock(\n"
    "    \"html\",\n"
    "    '<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">'\n"
    "      .. '<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>'\n"
    "      .. '<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?'\n"
    "      .. 'family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400&display=swap\">'\n"
    "  )\n"
    "end\n"
)

# _FIXPOINT_BLOCK_LUA — the signature hero mark (the design layer folding onto
# itself — "the map describes the mapmaker"). Structure only; color from the
# accent token. Emitted in the masthead's right hero column.
_FIXPOINT_BLOCK_LUA = (
    "-- fixpoint_block() -> the signature hero mark as inline SVG (accent-themed).\n"
    "local function fixpoint_block()\n"
    "  return pandoc.RawBlock(\"html\", [==[\n"
    "<div class=\"richmd-fixpoint\" aria-hidden=\"true\">\n"
    "  <svg viewBox=\"0 0 200 200\" style=\"width:100%;height:auto;\">\n"
    "    <circle cx=\"100\" cy=\"100\" r=\"86\" fill=\"none\" stroke=\"var(--richmd-color-accent-solid)\" stroke-width=\"1.5\" opacity=\".5\"/>\n"
    "    <rect x=\"58\" y=\"46\" width=\"84\" height=\"26\" rx=\"5\" fill=\"var(--richmd-color-accent-tint)\" stroke=\"var(--richmd-color-accent-solid)\" stroke-width=\"1.2\"/>\n"
    "    <rect x=\"58\" y=\"87\" width=\"84\" height=\"26\" rx=\"5\" fill=\"var(--richmd-color-accent-tint)\" stroke=\"var(--richmd-color-accent-solid)\" stroke-width=\"1.2\"/>\n"
    "    <rect x=\"58\" y=\"128\" width=\"84\" height=\"26\" rx=\"5\" fill=\"var(--richmd-color-accent-tint)\" stroke=\"var(--richmd-color-accent-solid)\" stroke-width=\"1.2\"/>\n"
    "    <path d=\"M142 59 C182 70 182 141 142 141\" fill=\"none\" stroke=\"var(--richmd-color-accent-solid)\" stroke-width=\"1.5\"/>\n"
    "    <path d=\"M58 100 C24 100 24 59 56 59\" fill=\"none\" stroke=\"var(--richmd-color-accent-solid)\" stroke-width=\"1.5\"/>\n"
    "  </svg>\n"
    "  <div style=\"font-family:var(--richmd-font-mono);font-size:11px;color:var(--richmd-color-text-faint);margin-top:8px;letter-spacing:.02em;\">layer &#8635; layer</div>\n"
    "</div>]==])\n"
    "end\n"
)

shell_lua = (
    "-- Generated by scripts/richmd-project — do not hand-edit.\n"
    "-- Document-shell hook (richmd#25 / ADR-0023): the 4th consumer contract.\n"
    "-- Renders the masthead (eyebrow, lede) and colophon (footer) from the\n"
    "-- page-identity frontmatter design_doc.frontmatter_keys declares; each\n"
    "-- region preserves the value's inline markup (links, bold) by reading the\n"
    "-- raw doc.meta metavalue, never stringifying. The masthead region also\n"
    "-- prepends the framework's semantic-look overlay as a projected <style>\n"
    "-- block (ADR-0024) — richmd owns the base look, the framework the semantic\n"
    "-- look. Structure is richmd-* region elements; richmd owns the base look.\n"
    + _SHELL_HELPER
    + "\n"
    + _style_block_lua(overlay_css)
    + "\n"
    + _FONTS_BLOCK_LUA
    + "\n"
    + _FIXPOINT_BLOCK_LUA
    + "\nreturn {\n"
    + _shell_region("masthead", masthead_keys, with_style=True)
    + _shell_region("colophon", colophon_keys)
    + "}\n"
)

shell_written = []
try:
    with open(os.path.join(shell_dir, "shell.lua"), "w", encoding="utf-8") as f:
        f.write(shell_lua)
    shell_written.append("shell")
except OSError as e:
    sys.stderr.write("richmd-project: error: cannot write shell.lua: %s\n" % e)
    sys.exit(2)


# --------------------------------------------------------------- group hook
# groups/foundation.lua — the document's 5th projected contract (richmd#27 /
# ADR-0015 / ADR-0025): a render-phase GROUP hook. richmd finds each maximal
# run of consecutive top-level blocks whose ORIGINAL kind the hook claims and
# replaces the run with the hook's returned Blocks. The four foundation
# statement kinds (goal, no-goal, invariant, principle) form four consecutive
# same-kind runs in §00, so the hook renders each run as ONE titled per-kind
# CARD SECTION (ADR-0025): a `<section class="richmd-group richmd-group--<kind>">`
# whose `<h3>` is the kind's plural display label over a `richmd-card-grid`
# whose children are NATIVE `.richmd-card` Divs. The hook RESHAPES each
# already-rendered `.richmd-statement` Div into the native card slots (ADR-0025
# amended) — its label inlines into `.richmd-card-title`, its badge Spans into
# `.richmd-card-meta` (omitted when there are none), its body into
# `.richmd-card-body` — so the foundation cards reuse the SAME card structure
# and styling as every other `cards` grid, rather than embedding a standalone
# statement's own two-column layout. Each card also carries `.richmd-card--<kind>`
# so the overlay can add a per-kind accent. The per-block statement renderers
# are UNTOUCHED — the reshape lives ONLY here (ADR-0025). The first run rendered
# also prepends a collapsed "How to read this" legend (a module-level latch keeps
# it to exactly one across the four runs).
#
# The claimed KIND SET is schema-derived — it IS foundation_kinds, the same
# statement-block set read from the schema above (design_doc.block_fields.
# statement_blocks / declared blocks). The legend's enumerated vocabulary — the
# four kinds, the enforcement values (enums.enforcement.values), the lens
# members (enums.lens.values) — is likewise schema-derived, the same discipline
# as every other projected artifact. The small plural display-label map is the
# framework's presentation choice, but it is BUILT from the schema kind set (a
# kind's label is derived from the kind string), so a schema kind change
# reprojects it. Output is deterministic and luac-clean; the file carries the
# do-not-hand-edit header.

def _plural_label(kind):
    # the display heading for a foundation kind's section — the kind string with
    # its FIRST letter capitalized (hyphen parts stay lowercase) plus a trailing
    # "s": goal->Goals, no-goal->No-goals, invariant->Invariants,
    # principle->Principles. Derived from the kind, so a schema kind rename
    # reprojects the label rather than needing a hand-kept literal.
    return kind[:1].upper() + kind[1:] + "s"


# the plural-label map as a Lua table literal, keyed by the schema kind strings.
_group_labels_lua = "{ " + ", ".join(
    '["%s"] = "%s"' % (k, _plural_label(k)) for k in foundation_kinds
) + " }"


def _lua_span(text, classes):
    # a small Lua expression building a pandoc.Span of Str(text) with the given
    # class list (a Lua list literal of quoted class strings).
    return 'pandoc.Span({ pandoc.Str("%s") }, pandoc.Attr("", %s))' % (
        text, "{ " + ", ".join('"%s"' % c for c in classes) + " }")


# --- legend rows, each SCHEMA-DERIVED where it enumerates vocabulary. ---
# Foundation row: one kind-label pill per foundation kind (its section heading
# label), classed richmd-group-legend--<kind> so the overlay tones it like the
# section it names.
_legend_kind_spans = ", ".join(
    _lua_span(_plural_label(k),
              ["richmd-badge", "richmd-group-legend--" + k])
    for k in foundation_kinds)
# Lenses row: one lens pill per lens member, each carrying its per-lens class
# (the same richmd-badge--lens-<member> the statement renderer emits).
_legend_lens_spans = ", ".join(
    _lua_span(m, ["richmd-badge", "richmd-badge--lens-" + m])
    for m in lens_values)
# Enforcement row: one chip per enforcement value, each carrying its per-value
# enforcement tone class (the same richmd-badge--enf-<value> the invariant
# renderer emits), strong -> weak in the schema's declared order.
_legend_enf_spans = ", ".join(
    _lua_span(e, ["richmd-badge", "richmd-badge--neutral", "richmd-badge--enf-" + e])
    for e in enforcement_values)

group_lua = (
    "-- Generated by scripts/richmd-project — do not hand-edit.\n"
    "-- Group render hook (richmd#27 / ADR-0015 / ADR-0025): the 5th projected\n"
    "-- contract. Claims the four foundation statement kinds and renders each\n"
    "-- maximal consecutive run as ONE titled per-kind CARD SECTION — a\n"
    "-- <section class=\"richmd-group richmd-group--<kind>\"> whose <h3> is the\n"
    "-- kind's plural label over a richmd-card-grid of NATIVE .richmd-card Divs.\n"
    "-- The hook RESHAPES each already-rendered .richmd-statement into the native\n"
    "-- card slots (ADR-0025 amended): label -> richmd-card-title, badge Spans ->\n"
    "-- richmd-card-meta (omitted when none), body -> richmd-card-body, so a\n"
    "-- foundation card reuses the SAME structure as every :::cards card. Each\n"
    "-- card also carries richmd-card--<kind> for the per-kind accent. The\n"
    "-- per-block statement renderers are untouched — the reshape lives only here\n"
    "-- (ADR-0025). The FIRST run rendered also prepends a collapsed \"How to read\n"
    "-- this\" legend; a module-level latch keeps it to exactly one. Kind set +\n"
    "-- legend vocabulary are schema-derived (foundation kinds, enforcement, lens).\n"
    "\n"
    "-- LABELS: the plural section heading per foundation kind, built from the\n"
    "-- schema kind strings (a schema kind change reprojects this map).\n"
    "local LABELS = " + _group_labels_lua + "\n"
    "\n"
    "-- legend_emitted — module-level latch. The hook's render runs once per\n"
    "-- consecutive run (four times over the foundation); the legend must appear\n"
    "-- exactly once, so the FIRST run to render emits it and flips this latch.\n"
    "local legend_emitted = false\n"
    "\n"
    "-- legend() -> the collapsed \"How to read this\" <details> block, naming the\n"
    "-- four foundation kinds and the enforcement + lens glyph key. Every\n"
    "-- enumerated row is schema-derived (see the projector). Built as pandoc\n"
    "-- nodes (a definition list inside a <details>/<summary>) so it renders\n"
    "-- through richmd's own writer, no raw HTML string.\n"
    "local function legend()\n"
    "  local kind_dd = pandoc.Div(\n"
    "    { pandoc.Plain({ " + _legend_kind_spans + " }) },\n"
    "    pandoc.Attr(\"\", { \"richmd-group-legend-row\" })\n"
    "  )\n"
    "  local lens_dd = pandoc.Div(\n"
    "    { pandoc.Plain({ " + _legend_lens_spans + ", "
    + _lua_span("judgment axes", ["richmd-group-legend-note"]) + " }) },\n"
    "    pandoc.Attr(\"\", { \"richmd-group-legend-row\" })\n"
    "  )\n"
    "  local enf_dd = pandoc.Div(\n"
    "    { pandoc.Plain({ " + _legend_enf_spans + ", "
    + _lua_span("strong → weak", ["richmd-group-legend-note"]) + " }) },\n"
    "    pandoc.Attr(\"\", { \"richmd-group-legend-row\" })\n"
    "  )\n"
    "  local rows = {\n"
    "    pandoc.Plain({ " + _lua_span("Foundation", ["richmd-group-legend-term"]) + " }),\n"
    "    kind_dd,\n"
    "    pandoc.Plain({ " + _lua_span("Lenses", ["richmd-group-legend-term"]) + " }),\n"
    "    lens_dd,\n"
    "    pandoc.Plain({ " + _lua_span("Enforcement", ["richmd-group-legend-term"]) + " }),\n"
    "    enf_dd,\n"
    "  }\n"
    "  local body = pandoc.Div(rows, pandoc.Attr(\"\", { \"richmd-group-legend-body\" }))\n"
    "  return pandoc.Div(\n"
    "    {\n"
    "      pandoc.RawBlock(\"html\", \"<details class=\\\"richmd-group-legend\\\"><summary>How to read this</summary>\"),\n"
    "      body,\n"
    "      pandoc.RawBlock(\"html\", \"</details>\"),\n"
    "    },\n"
    "    pandoc.Attr(\"\", { \"richmd-group-legend-wrap\" })\n"
    "  )\n"
    "end\n"
    "\n"
    "-- has_class(el, want) -> true if el's Attr classes include `want`.\n"
    "local function has_class(el, want)\n"
    "  if not el.attr then return false end\n"
    "  for _, c in ipairs(el.attr.classes or {}) do\n"
    "    if c == want then return true end\n"
    "  end\n"
    "  return false\n"
    "end\n"
    "\n"
    "-- reshape(stmt, kind) -> a native .richmd-card Div built from an\n"
    "-- already-rendered .richmd-statement Div, so a foundation card reuses the\n"
    "-- SAME slot anatomy every :::cards card has (ADR-0025 amended): the\n"
    "-- statement's LABEL inlines become richmd-card-title, its badge Spans\n"
    "-- become richmd-card-meta (omitted when there are none), and its body\n"
    "-- becomes richmd-card-body as a BARE <p> (the statement's\n"
    "-- <p class=\"richmd-statement-body\"> marker RawBlocks are stripped, so the\n"
    "-- card body is structurally identical to a real :::cards card body). The\n"
    "-- badge Spans are carried INTACT so their\n"
    "-- richmd-badge--lens-* / richmd-badge--enf-* modifier classes survive for\n"
    "-- the overlay. The per-block statement renderer is untouched — the reshape\n"
    "-- is confined to this group hook.\n"
    "local function reshape(stmt, kind)\n"
    "  -- locate the statement's child Divs by class; everything that is neither\n"
    "  -- the label Div is body content (the statement body is a\n"
    "  -- RawBlock/Plain/RawBlock trio, not a single Div, so collect the run).\n"
    "  local label_inlines = {}\n"
    "  local badge_spans = {}\n"
    "  local body_blocks = {}\n"
    "  for _, child in ipairs(stmt.content) do\n"
    "    if child.tag == \"Div\" and has_class(child, \"richmd-statement-label\") then\n"
    "      -- the label Div holds a single Plain of [Strong (the label), then\n"
    "      -- zero or more richmd-badge Spans]. Split the label inlines from the\n"
    "      -- badge Spans: a richmd-badge Span goes to meta, everything else\n"
    "      -- (the Strong, any Space) stays as the title.\n"
    "      local head = child.content[1]\n"
    "      for _, inl in ipairs((head and head.content) or {}) do\n"
    "        if inl.tag == \"Span\" and has_class(inl, \"richmd-badge\") then\n"
    "          table.insert(badge_spans, inl)\n"
    "        else\n"
    "          table.insert(label_inlines, inl)\n"
    "        end\n"
    "      end\n"
    "    elseif child.tag == \"RawBlock\"\n"
    "      and (child.text == '<p class=\"richmd-statement-body\">' or child.text == \"</p>\") then\n"
    "      -- The per-block statement renderer brackets the body Para in raw\n"
    "      -- <p class=\"richmd-statement-body\"> ... </p> markers (a Para carries\n"
    "      -- no Attr, so labeled-block.lua hangs the class on raw HTML). A real\n"
    "      -- :::cards card body is a BARE <p> — cards.lua wraps the authored\n"
    "      -- Para in .richmd-card-body with no statement class. Drop these two\n"
    "      -- marker RawBlocks so the card body matches a real cards card exactly;\n"
    "      -- the Plain between them is promoted to a Para just below.\n"
    "    elseif child.tag == \"Plain\" then\n"
    "      -- the statement body's flattened Plain (between the dropped markers).\n"
    "      -- Promote to a Para so it renders as a clean <p>...</p> — the same\n"
    "      -- shape cards.lua's authored-markdown card body produces.\n"
    "      table.insert(body_blocks, pandoc.Para(child.content))\n"
    "    else\n"
    "      table.insert(body_blocks, child)\n"
    "    end\n"
    "  end\n"
    "  local card_children = {}\n"
    "  table.insert(\n"
    "    card_children,\n"
    "    pandoc.Div(\n"
    "      { pandoc.Plain(label_inlines) },\n"
    "      pandoc.Attr(\"\", { \"richmd-card-title\" })\n"
    "    )\n"
    "  )\n"
    "  -- meta only when the statement carried badges (goals/no-goals have none).\n"
    "  if #badge_spans > 0 then\n"
    "    table.insert(\n"
    "      card_children,\n"
    "      pandoc.Div(\n"
    "        { pandoc.Plain(badge_spans) },\n"
    "        pandoc.Attr(\"\", { \"richmd-card-meta\" })\n"
    "      )\n"
    "    )\n"
    "  end\n"
    "  -- body: the statement's body blocks wrapped in richmd-card-body, exactly\n"
    "  -- as cards.lua wraps a card body (a no-goal may have no body — then the\n"
    "  -- run is empty and the wrapper is simply empty, never a crash).\n"
    "  table.insert(\n"
    "    card_children,\n"
    "    pandoc.Div(body_blocks, pandoc.Attr(\"\", { \"richmd-card-body\" }))\n"
    "  )\n"
    "  return pandoc.Div(\n"
    "    card_children,\n"
    "    pandoc.Attr(\"\", { \"richmd-card\", \"richmd-card--\" .. kind })\n"
    "  )\n"
    "end\n"
    "\n"
    "return {\n"
    "  kinds = " + lua_str_list(foundation_kinds) + ",\n"
    "  render = function(kind, rendered_blocks)\n"
    "    -- RESHAPE each already-rendered .richmd-statement Div into a native\n"
    "    -- .richmd-card (title/meta/body slots), laid in a richmd-card-grid under\n"
    "    -- the section's <h3> — the same card structure every :::cards grid uses.\n"
    "    local cards = {}\n"
    "    for _, node in ipairs(rendered_blocks) do\n"
    "      table.insert(cards, reshape(node, kind))\n"
    "    end\n"
    "    local grid = pandoc.Div(cards, pandoc.Attr(\"\", { \"richmd-card-grid\" }))\n"
    "    local label = LABELS[kind] or kind\n"
    "    local heading = pandoc.Header(3, pandoc.Str(label))\n"
    "    local section = pandoc.Div(\n"
    "      { heading, grid },\n"
    "      pandoc.Attr(\"\", { \"richmd-group\", \"richmd-group--\" .. kind })\n"
    "    )\n"
    "    -- the FIRST run rendered prepends the legend, once (latch).\n"
    "    if not legend_emitted then\n"
    "      legend_emitted = true\n"
    "      return pandoc.Blocks({ legend(), section })\n"
    "    end\n"
    "    return pandoc.Blocks({ section })\n"
    "  end,\n"
    "}\n"
)

groups_written = []
try:
    with open(os.path.join(groups_dir, "foundation.lua"), "w", encoding="utf-8") as f:
        f.write(group_lua)
    groups_written.append("foundation")
except OSError as e:
    sys.stderr.write("richmd-project: error: cannot write foundation.lua: %s\n" % e)
    sys.exit(2)


sys.stderr.write(
    "richmd-project: wrote %d block contract pair(s), %d token vocab(s), "
    "%d cross-block rule(s), %d shell hook(s), %d group hook(s) to %s (mermaid, "
    "vega-lite delegated to richmd built-ins)\n"
    % (len(written), len(tokens_written), len(rules_written),
       len(shell_written), len(groups_written), out_dir)
)
