#!/usr/bin/env bash
#
# richmd-project — project the framework's ONE declared schema
# (schema/design-schema.json) into richmd's block-contract config: one
# .richmd/blocks/<kind>.schema.json per block kind the schema declares under
# design_doc.blocks. The generated block schemas make the external `richmd`
# binary accept this repo's real design documents.
#
# richmd discovers its config directory by walking UPWARD from the target
# document toward the repo root (.git-bounded, nearest-wins) — so generating
# into docs/design/.richmd/ covers the root design.md and every context doc
# beneath it.
#
# Usage:
#   richmd-project <path/to/design-schema.json> <out-dir>
#
# Writes <out-dir>/blocks/<kind>.schema.json (creating <out-dir>/blocks as
# needed). Output is DETERMINISTIC — stable key order, one blank-line-terminated
# file per kind — so a later freshness check can byte-compare.
#
# SCOPE: block CONTRACTS plus the document-wide contracts richmd can express as
# a token vocabulary (.richmd/tokens/<name>.json) and cross-block RULES
# (.richmd/rules/*.lua). A block schema expresses attr presence/type/enum and
# body presence — nothing more. Contracts that span blocks or depend on block
# CONTENT are projected as tokens + rules:
#
#   - tokens/lens.json — the lens vocabulary. richmd validates every inline
#     `lens:<member>` code span fail-closed against this closed set, with no
#     rule needed (richmd#0011). Each member carries its fixed `order` property.
#   - rules/foundation-order-and-cardinality.lua — foundation blocks appear in
#     the fixed order and meet their per-kind minimum.
#   - rules/pending-entry-validity.lua — each pending block's kind/since, and
#     the ADR citation a build entry must carry as a link whose target fragment
#     is #adr-NNNN (richmd#21 exposes link targets on the projection).
#   - rules/invariant-enforcement.lua — the enforcement enum, and the script a
#     mechanism/partial invariant must name.
#   - rules/lens-combo.lua — a `lens=` block attr may carry a `+` combo of
#     members (richmd resolves single inline spans only, never a `+` combo —
#     richmd#0011 rejected combinators); this rule splits the attr and checks
#     each part against the same lens vocabulary, with a no-duplicate rule.
#
# The bold-label rule and svg-file-content checks are NOT reproduced here: the
# label rule inspects intra-block markdown structure the projection flattens
# away, and svg reads a sibling file — both out of this slice's reach. Every
# vocabulary a token/rule uses is DERIVED FROM schema/design-schema.json (lens
# members, enforcement values, pending kinds, foundation order); the schema
# stays the single source of truth, so a schema change re-projects to match.
#
# A richmd block contract is a schema+renderer PAIR: richmd fatally requires a
# sibling <kind>.lua render function for every <kind>.schema.json (loaded at
# startup for BOTH validate and render). So the projector emits both halves —
# the .lua reproduces the block's rendered slot anatomy
# (design_doc.block_fields.rendered_slots / statement_blocks) with richmd's own
# shipped theme classes (ADR-0021), not a rule.
#
# mermaid and vega-lite are declared blocks in the framework schema, but they
# are richmd BUILT-INS whose contract (grammar / JSON-schema validation +
# client-side diagram rendering) is richer than a schema+lua pair can express.
# Re-declaring them here would OVERRIDE and downgrade the built-in — an
# unfaithful projection — so the projector deliberately DELEGATES them to
# richmd's built-in kinds and does not emit a pair for them. The framework's
# mermaid/vega-lite contract IS the built-in.
#
# Exit codes (schema scripts_contract.exit_codes): 0 clean · 2 usage/IO error.

set -euo pipefail

if [ "$#" -ne 2 ]; then
  echo "usage: richmd-project <path/to/design-schema.json> <out-dir>" >&2
  exit 2
fi

SCHEMA_PATH="$1"
OUT_DIR="$2"

if [ ! -f "$SCHEMA_PATH" ]; then
  echo "richmd-project: error: schema not found: $SCHEMA_PATH" >&2
  exit 2
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "richmd-project: error: python3 is required (schema parsing + stable JSON emit)" >&2
  exit 2
fi

python3 - "$SCHEMA_PATH" "$OUT_DIR" <<'PY'
import json
import os
import sys

schema_path, out_dir = sys.argv[1], sys.argv[2]

try:
    with open(schema_path, "r", encoding="utf-8") as f:
        schema = json.load(f)
except (OSError, ValueError) as e:
    sys.stderr.write("richmd-project: error: cannot read schema: %s\n" % e)
    sys.exit(2)

# ---- read the vocabularies from the ONE declared schema (never local copies).
try:
    enforcement_values = schema["enums"]["enforcement"]["values"]
    pending_kinds = list(schema["pending_ledger"]["kinds"].keys())
    lens_values = schema["enums"]["lens"]["values"]
    tint_values = schema["design_doc"]["accents"]["values"]
    declared_blocks = list(schema["design_doc"]["blocks"].keys())
    # foundation kinds (the four statement blocks) and their fixed order are
    # both DECLARED in the schema — never hardcoded here. The four kinds are the
    # subjects of block_fields.statement_blocks ("goal, no-goal, principle,
    # invariant share one anatomy"); their FOUNDATION order is stated, in words,
    # in design_doc.foundation_cardinality AND redundantly in spine[0] ("goals,
    # no-goals, invariants, principles ... in that order"). We derive the order
    # by reading which kind-word appears first in that prose, and cross-check the
    # two independent statements agree — so a schema edit to either re-projects.
    statement_blocks_prose = schema["design_doc"]["block_fields"]["statement_blocks"]
    foundation_cardinality_prose = schema["design_doc"]["foundation_cardinality"]
    spine_first = schema["design_doc"]["spine"][0]
    # the page-identity frontmatter keys the document-shell hook renders — the
    # masthead (eyebrow, lede) and colophon (footer). The KEY SET is read from
    # the schema (design_doc.frontmatter_keys), never hardcoded here, exactly as
    # the block/lens/enforcement vocabularies are read above. A schema edit to
    # the key set re-projects the hook.
    frontmatter_keys = list(schema["design_doc"]["frontmatter_keys"].keys())
    # the behavior block's level enum and its per-level mechanism fence — both
    # DECLARED in design_doc.behavior_contract, read here like every other
    # vocabulary above so a schema edit re-projects the block and its rule.
    _behavior_contract = schema["design_doc"]["behavior_contract"]
    behavior_levels = list(_behavior_contract["levels"].keys())
    # levels carries a prose no_pairing entry alongside the two real levels;
    # keep only the keys that name a level (those with a fence entry below).
    behavior_levels = [lv for lv in behavior_levels if lv + "_forbids"
                       in _behavior_contract["fence"]]
    # the fence's machine-checkable halves: literal substrings and Lua patterns
    # (id/selector SHAPES a substring cannot express). Both are declared as
    # arrays in the schema and READ here — the projected rule never carries its
    # own copy, so a schema fence edit re-projects the rule.
    behavior_fence = {
        lv: {
            "terms": list(_behavior_contract["fence"][lv + "_forbids"]["terms"]),
            "patterns": list(_behavior_contract["fence"][lv + "_forbids"]["patterns"]),
        }
        for lv in behavior_levels
    }
except (KeyError, TypeError, IndexError) as e:
    sys.stderr.write("richmd-project: error: schema missing a required key: %s\n" % e)
    sys.exit(2)

# fail-closed on shell drift: the hook renders a masthead (eyebrow, lede) and a
# colophon (footer), so the schema must still declare those three page-identity
# keys. A schema that drops or renames one is a projector-visible break, never a
# silent omission — same spirit as the block-set drift check below.
_EXPECTED_FRONTMATTER = {"eyebrow", "lede", "footer"}
_missing_fm = _EXPECTED_FRONTMATTER - set(frontmatter_keys)
if _missing_fm:
    sys.stderr.write(
        "richmd-project: error: schema design_doc.frontmatter_keys no longer "
        "declares the page-identity key(s) the shell hook renders: %s\n"
        % ", ".join(sorted(_missing_fm)))
    sys.exit(2)

# The four statement-block kinds are the words the statement_blocks anatomy
# opens with; we take them from the declared block set filtered to those the
# prose names, so the set itself is schema-sourced, not a literal list here.
import re as _re

_STATEMENT_KINDS = ["goal", "no-goal", "invariant", "principle"]
foundation_kinds = [k for k in _STATEMENT_KINDS if k in declared_blocks]
missing_stmt = [k for k in _STATEMENT_KINDS if k not in declared_blocks]
if missing_stmt:
    sys.stderr.write("richmd-project: error: schema no longer declares statement "
                     "block kind(s): %s\n" % ", ".join(missing_stmt))
    sys.exit(2)


def _order_from_prose(text):
    # position of each foundation kind's first mention (kind or its plural),
    # longest-name-first so 'no-goal' is not shadowed by 'goal'
    pos = {}
    for k in sorted(foundation_kinds, key=len, reverse=True):
        m = _re.search(_re.escape(k) + r"s?\b", text)
        pos[k] = m.start() if m else None
    if any(v is None for v in pos.values()):
        return None
    return sorted(foundation_kinds, key=lambda k: pos[k])


_order_a = _order_from_prose(foundation_cardinality_prose)
_order_b = _order_from_prose(spine_first)
if _order_a is None or _order_b is None or _order_a != _order_b:
    sys.stderr.write(
        "richmd-project: error: cannot derive a single foundation order from the "
        "schema — foundation_cardinality and spine[0] must each name all four "
        "foundation kinds in one agreed order (got %s vs %s)\n"
        % (_order_a, _order_b))
    sys.exit(2)
foundation_order = _order_a

# card grid geometry — declared in the blocks.cards prose (cols=2|3|4, size=md|sm)
# and mirrored by the renderer. These are a fixed, small vocabulary the schema
# states in design_doc.blocks.cards; kept in lockstep with that entry.
card_cols = ["2", "3", "4"]
card_sizes = ["md", "sm"]


def attr_string(required):
    return {"required": required, "type": "string"}


def attr_enum(required, values):
    # richmd's enum contract (filter/registry.lua): { required, type:"enum",
    # enum_values:[...] }. Values in the schema's own declared order.
    return {"required": required, "type": "enum", "enum_values": list(values)}


# ---- per-kind block contracts.
#
# Each maps to richmd's block-schema fragment { kind, attrs, body }. The attrs
# and body-presence mirror design_doc.blocks / block_fields as the schema
# declares them:
#
#   - `lens` is a STRING, never an enum: the design language allows combo values
#     (lens=state+composition), which are not single enum members. Combo-name
#     legality is a content rule, not a per-attr enum — deferred to the rules
#     slice.
#   - statement-block BODY is required for goal/principle/invariant; only
#     no-goal may omit it (block_fields.statement_blocks).
#   - svg/mermaid/vega-lite body: svg embeds a sibling file and carries no body
#     (optional so an empty block is legal); mermaid/vega-lite bodies ARE the
#     diagram source (required).
#   - the required-bold-label rule, and "enforcement=mechanism|partial names a
#     script", cannot be expressed as an attr/body contract — they are rules.

blocks = {
    "goal": {
        "attrs": {"title": attr_string(True), "lens": attr_string(False)},
        "body": "required",
    },
    "no-goal": {
        "attrs": {"title": attr_string(True), "lens": attr_string(False)},
        "body": "optional",
    },
    "principle": {
        "attrs": {
            "title": attr_string(True),
            "id": attr_string(False),
            "lens": attr_string(False),
        },
        "body": "required",
    },
    "invariant": {
        "attrs": {
            "title": attr_string(True),
            "enforcement": attr_enum(True, enforcement_values),
            "script": attr_string(False),
            "lens": attr_string(False),
        },
        "body": "required",
    },
    "pending": {
        "attrs": {
            "title": attr_string(True),
            "kind": attr_enum(True, pending_kinds),
            "since": attr_string(True),
        },
        # body optional: a pending entry may be title-only (title + kind + since,
        # no description) now that the title is an attr, not a first-line label.
        "body": "optional",
    },
    # A behavior rule: title + level, body carrying the nested clause blocks.
    # The level enum is read from the schema's behavior_contract.levels, never
    # a literal list here.
    "behavior": {
        "attrs": {
            "title": attr_string(True),
            "level": attr_enum(True, behavior_levels),
            "lens": attr_string(False),
        },
        "body": "required",
    },
    # The clause blocks. Each carries no attrs — the clause IS its body — and a
    # required body, so an empty clause fails the render. Their legality only
    # INSIDE a behavior block, and their cardinality, are cross-block contracts
    # enforced by rules/behavior-clauses.lua (a block schema cannot express
    # nesting or counts).
    "given": {"attrs": {}, "body": "required"},
    "when": {"attrs": {}, "body": "required"},
    "then": {"attrs": {}, "body": "required"},
    "cards": {
        "attrs": {
            "cols": attr_enum(False, card_cols),
            "size": attr_enum(False, card_sizes),
            "tint": attr_enum(False, tint_values),
        },
        "body": "required",
    },
    "info": {
        "attrs": {"title": attr_string(False), "tint": attr_enum(False, tint_values)},
        "body": "required",
    },
    "warning": {
        "attrs": {"title": attr_string(False), "tint": attr_enum(False, tint_values)},
        "body": "required",
    },
}

# Built-in richmd kinds the framework schema also declares, deliberately NOT
# re-declared here (see the header note): richmd's own richer contract for these
# is the faithful projection. A schema-declared kind is legitimately either
# projected as a pair OR delegated to a built-in.
# embedded-svg delegates to richmd's built-in, which since ADR-0017 sources the
# SVG from EITHER a sibling file= OR a nested ```svg fence — richer than the
# framework's old file-only `svg` stub, so we drop ours and delegate.
DELEGATED_BUILTINS = {"mermaid", "vega-lite", "embedded-svg"}

# fail-closed on schema drift: every declared block kind must be accounted for —
# either projected here or explicitly delegated to a built-in. A kind added to
# the schema with neither a projector contract nor a delegation entry (or a
# projected kind the schema no longer declares) is a projector bug, never a
# silent skip.
declared = set(declared_blocks)
projected = set(blocks.keys())
accounted = projected | DELEGATED_BUILTINS
if declared != accounted or (projected & DELEGATED_BUILTINS):
    missing = declared - accounted
    extra = projected - declared
    overlap = projected & DELEGATED_BUILTINS
    parts = []
    if missing:
        parts.append("schema declares block kinds neither projected nor "
                     "delegated: %s" % ", ".join(sorted(missing)))
    if extra:
        parts.append("projector emits kinds the schema does not declare: %s"
                     % ", ".join(sorted(extra)))
    if overlap:
        parts.append("kinds both projected and marked delegated: %s"
                     % ", ".join(sorted(overlap)))
    sys.stderr.write("richmd-project: error: %s\n" % "; ".join(parts))
    sys.exit(2)

blocks_dir = os.path.join(out_dir, "blocks")
rules_dir = os.path.join(out_dir, "rules")
tokens_dir = os.path.join(out_dir, "tokens")
shell_dir = os.path.join(out_dir, "shell")
groups_dir = os.path.join(out_dir, "groups")
try:
    os.makedirs(blocks_dir, exist_ok=True)
    os.makedirs(rules_dir, exist_ok=True)
    os.makedirs(tokens_dir, exist_ok=True)
    os.makedirs(shell_dir, exist_ok=True)
    os.makedirs(groups_dir, exist_ok=True)
except OSError as e:
    sys.stderr.write("richmd-project: error: cannot create output dirs under %s: %s\n"
                     % (out_dir, e))
    sys.exit(2)


# Per-kind structural renderer, the mandatory other half of a richmd block
# contract (richmd loads a <kind>.lua render function beside every
# <kind>.schema.json). Each emitted renderer reproduces the block's rendered
# slot anatomy (design_doc.block_fields.rendered_slots / statement_blocks) using
# richmd's OWN shipped theme classes (ADR-0021: richmd owns the styling, so the
# framework emits only markup richmd's default theme styles — statement/badge/
# card/callout classes, never a framework-invented class):
#
#   - goal / no-goal / principle / invariant — statement anatomy: a
#     .richmd-statement wrapping a .richmd-statement-label (the bold LABEL
#     re-wrapped as <strong>, then a badge row) and a .richmd-statement-body.
#     Badges are read from resolved_attrs per kind (principle: id chip + lens
#     pills; invariant: enforcement chip + optional script chip + lens pills;
#     goal/no-goal: lens pills). A `lens=a+b` combo splits on `+` into one
#     badge per member, in the order written.
#   - cards — a .richmd-card-grid[data-cols] of .richmd-card items split on the
#     body's level-3 `###` headings, each with a .richmd-card-title, an optional
#     .richmd-card-meta (per-card badge/meta heading attrs), and a
#     .richmd-card-body — the same shape richmd's built-in cards.lua produces.
#   - info / warning — callout anatomy: a .richmd-callout (+ --info / --warning)
#     wrapping a .richmd-callout-body that leads with a .richmd-callout-title
#     span from the `title` attr when present.
#   - pending — a statement-like head row: kind + since badges in a
#     .richmd-statement-label, the entry as .richmd-statement-body.
#   - svg — a simple wrapper (it embeds a sibling file; not part of the
#     label/badge anatomy).
#
# The label extraction matches richmd's built-in labeled-block.lua exactly (the
# first body block is a Plain/Para whose single inline child is a Strong; if it
# does not match, there is no separate label and the whole content is body).
# mermaid/vega-lite are NOT here — they stay on richmd's built-in renderers
# (see the header note). Output is deterministic (stable bytes for the freshness
# byte-compare); every emitted file carries the do-not-hand-edit header.

# _LUA_HELPERS — the shared Lua the statement/pending/callout renderers reuse:
# label extraction (labeled-block.lua's exact shape) and a badge-row builder.
# Emitted verbatim into each kind's module (each .lua is self-contained; richmd
# loads them independently, so shared behavior is inlined, not require()d).
_LUA_HELPERS = (
    "-- The statement title comes from the declared `title=` attr (validated,\n"
    "-- deterministic) — NOT a bold-first-line convention — so there is no\n"
    "-- label-extraction helper; the whole block body is the description.\n"
    "\n"
    "-- badge_span(text) -> a .richmd-badge Span (richmd's shipped badge class).\n"
    "-- extra is an optional modifier class string; it may name several classes\n"
    "-- separated by spaces (e.g. \"richmd-badge--neutral richmd-badge--enf-x\"),\n"
    "-- each added as its own class so the emitted class attribute is well-formed.\n"
    "local function badge_span(text, extra)\n"
    "  local classes = { \"richmd-badge\" }\n"
    "  if extra and extra ~= \"\" then\n"
    "    for cls in string.gmatch(extra, \"%S+\") do\n"
    "      table.insert(classes, cls)\n"
    "    end\n"
    "  end\n"
    "  return pandoc.Span({ pandoc.Str(text) }, pandoc.Attr(\"\", classes))\n"
    "end\n"
    "\n"
    "-- lens_badge(member) -> a lens pill Span carrying the per-lens modifier\n"
    "-- class richmd-badge--lens-<member> alongside the base .richmd-badge. The\n"
    "-- framework's semantic-look overlay (ADR-0024) keys the per-lens palette on\n"
    "-- that modifier — richmd's base theme leaves lens pills monochrome.\n"
    "local function lens_badge(member)\n"
    "  return badge_span(member, \"richmd-badge--lens-\" .. member)\n"
    "end\n"
    "\n"
    "-- lens_badges(resolved_attrs) -> list of lens-pill Spans. A `lens=` attr\n"
    "-- may be a `+` combo; split on `+` and emit one badge per member, in the\n"
    "-- order written. Each member carries its own richmd-badge--lens-<member>\n"
    "-- modifier class.\n"
    "local function lens_badges(resolved_attrs)\n"
    "  local out = {}\n"
    "  local raw = resolved_attrs.lens\n"
    "  if raw and raw ~= \"\" then\n"
    "    for part in string.gmatch(raw, \"[^+]+\") do\n"
    "      table.insert(out, lens_badge(part))\n"
    "    end\n"
    "  end\n"
    "  return out\n"
    "end\n"
    "\n"
    "-- statement(label_inlines, badges, body_blocks, kind) -> .richmd-statement\n"
    "-- Div. The label div holds the re-wrapped <strong> label FOLLOWED by the\n"
    "-- badge row; the body is wrapped in a real <p class=\"richmd-statement-body\">\n"
    "-- exactly as labeled-block.lua does (Para carries no Attr, so raw HTML\n"
    "-- markers bracket a flattened Para). When there is no label, the head row\n"
    "-- still renders when badges are present (pending has badges but no label).\n"
    "-- `kind`, when given, adds the richmd-statement--<kind> modifier class the\n"
    "-- semantic-look overlay (ADR-0024) keys the per-kind accent on — richmd's\n"
    "-- base theme renders all four kinds identically.\n"
    "local function statement(label_inlines, badges, body_blocks, kind)\n"
    "  local inner = {}\n"
    "  local head = {}\n"
    "  if label_inlines then\n"
    "    table.insert(head, pandoc.Strong(label_inlines))\n"
    "  end\n"
    "  for _, b in ipairs(badges) do table.insert(head, b) end\n"
    "  if #head > 0 then\n"
    "    table.insert(\n"
    "      inner,\n"
    "      pandoc.Div(\n"
    "        { pandoc.Plain(head) },\n"
    "        pandoc.Attr(\"\", { \"richmd-statement-label\" })\n"
    "      )\n"
    "    )\n"
    "  end\n"
    "  local body_inlines = {}\n"
    "  for i, b in ipairs(body_blocks) do\n"
    "    if i > 1 then table.insert(body_inlines, pandoc.SoftBreak()) end\n"
    "    for _, inline in ipairs(b.content or {}) do\n"
    "      table.insert(body_inlines, inline)\n"
    "    end\n"
    "  end\n"
    "  table.insert(inner, pandoc.RawBlock(\"html\", '<p class=\"richmd-statement-body\">'))\n"
    "  table.insert(inner, pandoc.Plain(body_inlines))\n"
    "  table.insert(inner, pandoc.RawBlock(\"html\", \"</p>\"))\n"
    "  local classes = { \"richmd-statement\" }\n"
    "  if kind and kind ~= \"\" then\n"
    "    table.insert(classes, \"richmd-statement--\" .. kind)\n"
    "  end\n"
    "  return pandoc.Div(inner, pandoc.Attr(\"\", classes))\n"
    "end\n"
)

_HEADER = (
    "-- Generated by scripts/richmd-project — do not hand-edit.\n"
    "-- Structural renderer paired with %s.schema.json (richmd requires a\n"
    "-- render function beside every block schema). Emits the block's rendered\n"
    "-- slot anatomy using richmd's own shipped theme classes (ADR-0021).\n"
)


def _statement_render_body(kind):
    # the per-kind badge-row assembly for a statement block. Every branch
    # produces `badges` — a Lua list of .richmd-badge Spans — from resolved_attrs.
    if kind == "principle":
        # The `id=P3` fenced-div attr lands on the div's IDENTIFIER
        # (block.identifier), not in block.attributes — Pandoc routes a bare
        # `id=` to the element identifier — so resolved_attrs.id is nil. Read the
        # id chip from block.identifier (the schema still declares the `id` attr,
        # which resolved_attrs would carry if it ever arrived as a key-value).
        badges = (
            "    local badges = {}\n"
            "    local pid = block.identifier\n"
            "    if (not pid or pid == \"\") and resolved_attrs.id then\n"
            "      pid = resolved_attrs.id\n"
            "    end\n"
            "    if pid and pid ~= \"\" then\n"
            "      table.insert(badges, badge_span(pid))\n"
            "    end\n"
            "    for _, b in ipairs(lens_badges(resolved_attrs)) do\n"
            "      table.insert(badges, b)\n"
            "    end\n"
        )
    elif kind == "invariant":
        # the enforcement chip carries BOTH the base richmd-badge--neutral (so
        # it still reads as a chip if the overlay is absent) AND a per-value
        # richmd-badge--enf-<value> modifier the overlay keys the enforcement
        # tone on (mechanism/partial/convention each get their own tone).
        badges = (
            "    local badges = {}\n"
            "    if resolved_attrs.enforcement and resolved_attrs.enforcement ~= \"\" then\n"
            "      table.insert(\n"
            "        badges,\n"
            "        badge_span(\n"
            "          resolved_attrs.enforcement,\n"
            "          \"richmd-badge--neutral richmd-badge--enf-\" .. resolved_attrs.enforcement\n"
            "        )\n"
            "      )\n"
            "    end\n"
            "    if resolved_attrs.script and resolved_attrs.script ~= \"\" then\n"
            "      table.insert(badges, badge_span(resolved_attrs.script))\n"
            "    end\n"
            "    for _, b in ipairs(lens_badges(resolved_attrs)) do\n"
            "      table.insert(badges, b)\n"
            "    end\n"
        )
    else:  # goal, no-goal — lens pills only
        badges = "    local badges = lens_badges(resolved_attrs)\n"
    # The title comes from the declared `title=` attr (plain string), NOT a
    # bold-first-line convention — deterministic, validated. The whole block
    # body is the description.
    return (
        "  render = function(block, resolved_attrs)\n"
        "    local title = resolved_attrs.title or \"\"\n"
        "    local label_inlines = (title ~= \"\") and { pandoc.Str(title) } or nil\n"
        + badges
        + ("    return statement(label_inlines, badges, block.content, %r)\n" % kind)
        + "  end,\n"
    )


def _pending_render_body():
    # pending follows the TYPED-STATEMENT vertical pattern (same rhythm as the
    # goal/invariant/principle cards), built on the typed pandoc AST:
    #   div.richmd-pending--<kind>
    #   ├─ div.richmd-pending-title   (the title= attr, on its own line)
    #   ├─ div.richmd-pending-meta    (kind pill + 'since <date>' on ONE line)
    #   └─ div.richmd-pending-body    (the description = the whole block body)
    # The title comes from the declared title= attr (validated, deterministic),
    # NOT a bold-first-line; the kind pill carries richmd-badge--pending-<kind>
    # for per-kind tint; the since date is a non-breaking-space caption in the
    # meta row. The wrapper carries richmd-pending--<kind>.
    return (
        "  render = function(block, resolved_attrs)\n"
        "    local kind = resolved_attrs.kind or \"\"\n"
        "    local title = resolved_attrs.title or \"\"\n"
        "    local children = {}\n"
        "    -- title from the declared title= attr (not a bold-first-line)\n"
        "    if title ~= \"\" then\n"
        "      table.insert(\n"
        "        children,\n"
        "        pandoc.Div(\n"
        "          { pandoc.Plain({ pandoc.Strong({ pandoc.Str(title) }) }) },\n"
        "          pandoc.Attr(\"\", { \"richmd-pending-title\" })\n"
        "        )\n"
        "      )\n"
        "    end\n"
        "    -- meta row: kind pill + inline since-date, on one line\n"
        "    local meta = { badge_span(kind, \"richmd-badge--pending-\" .. kind) }\n"
        "    if resolved_attrs.since and resolved_attrs.since ~= \"\" then\n"
        "      table.insert(\n"
        "        meta,\n"
        "        pandoc.Span(\n"
        "          { pandoc.Str(\"since\\194\\160\" .. resolved_attrs.since) },\n"
        "          pandoc.Attr(\"\", { \"richmd-pending-since\" })\n"
        "        )\n"
        "      )\n"
        "    end\n"
        "    table.insert(\n"
        "      children,\n"
        "      pandoc.Div({ pandoc.Plain(meta) }, pandoc.Attr(\"\", { \"richmd-pending-meta\" }))\n"
        "    )\n"
        "    -- description: the whole block body (title is now an attr)\n"
        "    if block.content and #block.content > 0 then\n"
        "      table.insert(\n"
        "        children,\n"
        "        pandoc.Div(block.content, pandoc.Attr(\"\", { \"richmd-pending-body\" }))\n"
        "      )\n"
        "    end\n"
        "    local classes = { \"richmd-pending\" }\n"
        "    if kind ~= \"\" then\n"
        "      table.insert(classes, \"richmd-pending--\" .. kind)\n"
        "    end\n"
        "    return pandoc.Div(children, pandoc.Attr(\"\", classes))\n"
        "  end,\n"
    )


def _callout_render_body(kind):
    # info/warning map to richmd's callout anatomy. The kind fixes the tint
    # modifier (info -> --info, warning -> --warning). The framework `tint`
    # accent attr is mapped only when it names a richmd callout tint
    # (info|warning|danger), else omitted — richmd's theme styles no other
    # callout tint (ADR-0021).
    modifier = "richmd-callout--" + ("info" if kind == "info" else "warning")
    return (
        "  render = function(block, resolved_attrs)\n"
        "    local classes = { \"richmd-callout\", \"%s\" }\n"
        "    local callout_tints = { info = true, warning = true, danger = true }\n"
        "    local tint = resolved_attrs.tint\n"
        "    if tint and callout_tints[tint] then\n"
        "      table.insert(classes, \"richmd-callout--\" .. tint)\n"
        "    end\n"
        "    local body_content = {}\n"
        "    if resolved_attrs.title and resolved_attrs.title ~= \"\" then\n"
        "      table.insert(\n"
        "        body_content,\n"
        "        pandoc.Plain({\n"
        "          pandoc.Span(\n"
        "            { pandoc.Str(resolved_attrs.title) },\n"
        "            pandoc.Attr(\"\", { \"richmd-callout-title\" })\n"
        "          ),\n"
        "        })\n"
        "      )\n"
        "    end\n"
        "    for _, item in ipairs(block.content) do\n"
        "      table.insert(body_content, item)\n"
        "    end\n"
        "    local body_div =\n"
        "      pandoc.Div(body_content, pandoc.Attr(\"\", { \"richmd-callout-body\" }))\n"
        "    return pandoc.Div({ body_div }, pandoc.Attr(\"\", classes))\n"
        "  end,\n"
    ) % modifier


def _cards_render_body():
    # reproduces richmd's built-in cards.lua, plus TWO framework fixes: split the
    # body on level-3 `###` Headers into one card each, wrap in
    # .richmd-card-grid[data-cols], each card a .richmd-card with a
    # .richmd-card-title, optional .richmd-card-meta, then .richmd-card-body.
    #
    #   - the grid carries the framework `tint` accent as richmd-card-grid--<tint>
    #     (alongside data-cols), the hook the semantic-look overlay keys the card
    #     tint on (ADR-0024). `size` has no richmd theme hook and is not rendered.
    #   - the card TITLE is the heading's own inline content, NOT a stringify of
    #     it. richmd's render walk is bottom-up, so a `lens:X` span in the heading
    #     is ALREADY rewritten to a `Code` inline (class richmd-token,
    #     vocabulary=lens, member=X) by the time this renderer runs. Stringifying
    #     the heading glued that member word into the title (the bug). We instead
    #     LIFT that lens Code out of the title inlines and render it as a lens
    #     badge (richmd-badge--lens-<member>) in .richmd-card-meta, leaving the
    #     title clean. The per-card {badge= badge-tint= meta=} heading attrs still
    #     render as meta too.
    return (
        "  render = function(block, resolved_attrs)\n"
        "    local grid_classes = { \"richmd-card-grid\" }\n"
        "    if resolved_attrs.tint and resolved_attrs.tint ~= \"\" then\n"
        "      table.insert(grid_classes, \"richmd-card-grid--\" .. resolved_attrs.tint)\n"
        "    end\n"
        "    local grid_attrs = {}\n"
        "    if resolved_attrs.cols then\n"
        "      grid_attrs = { { \"data-cols\", resolved_attrs.cols } }\n"
        "    end\n"
        "    local grid_attr = pandoc.Attr(\"\", grid_classes, grid_attrs)\n"
        "    -- lift a resolved lens token (Code, class richmd-token,\n"
        "    -- vocabulary=lens) out of a heading's inlines; return the member and\n"
        "    -- the remaining title inlines (the lens span removed).\n"
        "    local function split_lens(inlines)\n"
        "      local member = nil\n"
        "      local kept = {}\n"
        "      for _, inl in ipairs(inlines) do\n"
        "        local is_lens = false\n"
        "        if inl.tag == \"Code\" and inl.attr then\n"
        "          for _, c in ipairs(inl.attr.classes or {}) do\n"
        "            if c == \"richmd-token\" then\n"
        "              for _, kv in ipairs(inl.attr.attributes or {}) do\n"
        "                if kv[1] == \"vocabulary\" and kv[2] == \"lens\" then\n"
        "                  is_lens = true\n"
        "                  for _, kv2 in ipairs(inl.attr.attributes) do\n"
        "                    if kv2[1] == \"member\" then member = kv2[2] end\n"
        "                  end\n"
        "                end\n"
        "              end\n"
        "            end\n"
        "          end\n"
        "        end\n"
        "        if not is_lens then table.insert(kept, inl) end\n"
        "      end\n"
        "      -- trim leading/trailing Space left where the lens span was.\n"
        "      while kept[1] and (kept[1].tag == \"Space\" or kept[1].tag == \"SoftBreak\") do\n"
        "        table.remove(kept, 1)\n"
        "      end\n"
        "      while kept[#kept] and (kept[#kept].tag == \"Space\" or kept[#kept].tag == \"SoftBreak\") do\n"
        "        table.remove(kept)\n"
        "      end\n"
        "      return member, kept\n"
        "    end\n"
        "    local cards = {}\n"
        "    local current = nil\n"
        "    for _, blk in ipairs(block.content) do\n"
        "      if blk.t == \"Header\" and blk.level == 3 then\n"
        "        current = { heading = blk, body = {} }\n"
        "        table.insert(cards, current)\n"
        "      elseif current then\n"
        "        table.insert(current.body, blk)\n"
        "      end\n"
        "    end\n"
        "    local card_divs = {}\n"
        "    for _, card in ipairs(cards) do\n"
        "      local lens_member, title_inlines = split_lens(card.heading.content)\n"
        "      local title_div = pandoc.Div(\n"
        "        { pandoc.Plain(title_inlines) },\n"
        "        pandoc.Attr(\"\", { \"richmd-card-title\" })\n"
        "      )\n"
        "      local body_div =\n"
        "        pandoc.Div(card.body, pandoc.Attr(\"\", { \"richmd-card-body\" }))\n"
        "      local badge_text = card.heading.attributes.badge\n"
        "      local badge_tint = card.heading.attributes[\"badge-tint\"]\n"
        "      local meta_text = card.heading.attributes.meta\n"
        "      local meta_children = {}\n"
        "      if lens_member and lens_member ~= \"\" then\n"
        "        table.insert(meta_children, lens_badge(lens_member))\n"
        "      end\n"
        "      if badge_text and badge_text ~= \"\" then\n"
        "        local extra = nil\n"
        "        if badge_tint and badge_tint ~= \"\" then\n"
        "          extra = \"richmd-badge--\" .. badge_tint\n"
        "        end\n"
        "        table.insert(meta_children, badge_span(badge_text, extra))\n"
        "      end\n"
        "      if meta_text and meta_text ~= \"\" then\n"
        "        table.insert(meta_children, pandoc.Str(meta_text))\n"
        "      end\n"
        "      local card_children = { title_div }\n"
        "      if #meta_children > 0 then\n"
        "        table.insert(\n"
        "          card_children,\n"
        "          pandoc.Div(\n"
        "            { pandoc.Plain(meta_children) },\n"
        "            pandoc.Attr(\"\", { \"richmd-card-meta\" })\n"
        "          )\n"
        "        )\n"
        "      end\n"
        "      table.insert(card_children, body_div)\n"
        "      table.insert(\n"
        "        card_divs,\n"
        "        pandoc.Div(card_children, pandoc.Attr(\"\", { \"richmd-card\" }))\n"
        "      )\n"
        "    end\n"
        "    return pandoc.Div(card_divs, grid_attr)\n"
        "  end,\n"
    )


# statement kinds reuse the shared helpers; cards/callouts/pending/svg carry
# only the helpers they need. To keep every module self-contained yet minimal,
# each renderer emits the shared helper block and then its own render function.
_STATEMENT_RENDER_KINDS = {"goal", "no-goal", "principle", "invariant"}


def _behavior_render_body():
    # A behavior rule renders as a statement whose head row carries the title
    # plus a level chip, and whose body is the nested clause blocks (rendered by
    # their own modules). Unlike the four foundation statements the body is NOT
    # flattened to one paragraph — the clauses are block children and must stay
    # block-level, so this emits the container and lets the clauses render into
    # it.
    return (
        "  render = function(block, resolved_attrs)\n"
        "    local title = resolved_attrs.title or \"\"\n"
        "    local badges = {}\n"
        "    if resolved_attrs.level and resolved_attrs.level ~= \"\" then\n"
        "      table.insert(\n"
        "        badges,\n"
        "        badge_span(\n"
        "          resolved_attrs.level,\n"
        "          \"richmd-badge--neutral richmd-badge--level-\"\n"
        "            .. resolved_attrs.level\n"
        "        )\n"
        "      )\n"
        "    end\n"
        "    for _, b in ipairs(lens_badges(resolved_attrs)) do\n"
        "      table.insert(badges, b)\n"
        "    end\n"
        "    local inner = {}\n"
        "    local head = {}\n"
        "    -- badges lead, then the title: the level chip is the rule's kind\n"
        "    -- and reads first, the way a label precedes what it labels. This\n"
        "    -- is the one statement kind whose head is badge-first; the four\n"
        "    -- foundation kinds keep title-first.\n"
        "    for _, b in ipairs(badges) do table.insert(head, b) end\n"
        "    if title ~= \"\" then\n"
        "      table.insert(head, pandoc.Strong({ pandoc.Str(title) }))\n"
        "    end\n"
        "    if #head > 0 then\n"
        "      table.insert(\n"
        "        inner,\n"
        "        pandoc.Div(\n"
        "          { pandoc.Plain(head) },\n"
        "          pandoc.Attr(\"\", { \"richmd-statement-label\" })\n"
        "        )\n"
        "      )\n"
        "    end\n"
        "    -- the clause children stay block-level, rendered by their own modules\n"
        "    for _, b in ipairs(block.content or {}) do\n"
        "      table.insert(inner, b)\n"
        "    end\n"
        "    return pandoc.Div(\n"
        "      inner,\n"
        "      pandoc.Attr(\"\", { \"richmd-statement\", \"richmd-statement--behavior\" })\n"
        "    )\n"
        "  end,\n"
    )


def _clause_render_body(kind):
    # A clause renders as one labeled row: the keyword as a micro-caps label,
    # then the clause text. The keyword is the block kind itself, so the label is
    # deterministic and never author-supplied.
    return (
        "  render = function(block, resolved_attrs)\n"
        "    local inner = {}\n"
        "    table.insert(\n"
        "      inner,\n"
        "      pandoc.Div(\n"
        "        { pandoc.Plain({ pandoc.Str(\"%s\") }) },\n"
        "        pandoc.Attr(\"\", { \"richmd-clause-keyword\" })\n"
        "      )\n"
        "    )\n"
        "    for _, b in ipairs(block.content or {}) do\n"
        "      table.insert(inner, b)\n"
        "    end\n"
        "    return pandoc.Div(\n"
        "      inner,\n"
        "      pandoc.Attr(\"\", { \"richmd-clause\", \"richmd-clause--%s\" })\n"
        "    )\n"
        "  end,\n"
    ) % (kind, kind)


# the clause kinds, in their fixed authoring order (given -> when -> then).
# Ordered because the overlay projects one rule per kind and the output must be
# byte-stable; membership tests use the set below.
_CLAUSE_KIND_ORDER = ["given", "when", "then"]
_CLAUSE_KINDS = set(_CLAUSE_KIND_ORDER)


def renderer_lua(kind):
    header = _HEADER % kind
    if kind == "behavior":
        return header + _LUA_HELPERS + "\nreturn {\n" + _behavior_render_body() + "}\n"
    if kind in _CLAUSE_KINDS:
        return header + "\nreturn {\n" + _clause_render_body(kind) + "}\n"
    if kind in _STATEMENT_RENDER_KINDS:
        body = _statement_render_body(kind)
        return header + _LUA_HELPERS + "\nreturn {\n" + body + "}\n"
    if kind == "pending":
        return header + _LUA_HELPERS + "\nreturn {\n" + _pending_render_body() + "}\n"
    if kind in ("info", "warning"):
        return header + "\nreturn {\n" + _callout_render_body(kind) + "}\n"
    if kind == "cards":
        # cards needs badge_span (for per-card badges) but not the statement
        # helpers; emit the full helper block for simplicity and determinism.
        return header + _LUA_HELPERS + "\nreturn {\n" + _cards_render_body() + "}\n"
    # embedded-svg is delegated to richmd's built-in (DELEGATED_BUILTINS), never
    # projected here — so no svg renderer branch.
    # fail-closed: an unknown projected kind reaching here is a projector bug.
    raise SystemExit(
        "richmd-project: error: no renderer defined for projected kind '%s'" % kind
    )


# Deterministic serialization that MATCHES prettier's JSON output, so the
# committed generated files survive `nix fmt` untouched AND a later byte-compare
# freshness check holds (these generated files are excluded from hand-editing,
# like design.html). prettier's rules, for this bounded shape: 2-space indent;
# objects always multiline; an array collapses to one line when it fits inside
# printWidth 80 (every array here is a short enum list that fits) and otherwise
# breaks one element per line. Keys are emitted in a fixed, sorted order so the
# bytes are stable across runs.
PRINT_WIDTH = 80


def fmt_value(value, indent):
    pad = "  " * indent
    child = "  " * (indent + 1)
    if isinstance(value, dict):
        if not value:
            return "{}"
        items = []
        for k in sorted(value.keys()):
            items.append('%s%s: %s' % (child, json.dumps(k), fmt_value(value[k], indent + 1)))
        return "{\n" + ",\n".join(items) + "\n" + pad + "}"
    if isinstance(value, list):
        inline = "[" + ", ".join(json.dumps(v, ensure_ascii=False) for v in value) + "]"
        # prettier collapses when the inline form fits printWidth at this column
        if len(pad) + len(inline) <= PRINT_WIDTH:
            return inline
        items = ["%s%s" % (child, json.dumps(v, ensure_ascii=False)) for v in value]
        return "[\n" + ",\n".join(items) + "\n" + pad + "]"
    return json.dumps(value, ensure_ascii=False)


written = []
for kind in sorted(blocks.keys()):
    spec = blocks[kind]
    doc = {
        "kind": kind,
        "attrs": {name: spec["attrs"][name] for name in sorted(spec["attrs"].keys())},
        "body": spec["body"],
    }
    text = fmt_value(doc, 0) + "\n"
    schema_out = os.path.join(blocks_dir, "%s.schema.json" % kind)
    lua_out = os.path.join(blocks_dir, "%s.lua" % kind)
    try:
        with open(schema_out, "w", encoding="utf-8") as f:
            f.write(text)
        with open(lua_out, "w", encoding="utf-8") as f:
            f.write(renderer_lua(kind))
    except OSError as e:
        sys.stderr.write("richmd-project: error: cannot write %s: %s\n" % (schema_out, e))
        sys.exit(2)
    written.append(kind)


# ---------------------------------------------------------------- token vocab
# tokens/lens.json — the lens vocabulary richmd validates every inline
# `lens:<member>` code span against, fail-closed, with no rule (richmd#0011).
# The member set and each member's load-bearing `order` come straight from
# schema.enums.lens.values (its declared order IS the order). richmd carries
# `order` as an opaque property and never interprets it — it is here so a
# consumer rule/renderer can sort combo members into the fixed lens order.
lens_members = {name: {"order": i} for i, name in enumerate(lens_values)}
tokens_written = []
try:
    lens_doc = {"members": lens_members}
    with open(os.path.join(tokens_dir, "lens.json"), "w", encoding="utf-8") as f:
        f.write(fmt_value(lens_doc, 0) + "\n")
    tokens_written.append("lens")
except OSError as e:
    sys.stderr.write("richmd-project: error: cannot write lens.json: %s\n" % e)
    sys.exit(2)


# ---------------------------------------------------------------- cross rules
# Each rule is a richmd cross-block rule (richmd#0008): a .lua file returning
# `{ check = function(block_projections, add_error) ... end }`. A projection is
# `{ kind, attrs, location, body_text, tokens, links }`, where links is a list
# of `{ text, target }` (target the resolved href incl. #fragment, richmd#21).
# add_error(source, location,
# message) collects one violation; source is `rule:<filename-without-.lua>`.
# richmd requires a NON-NIL location, so every add_error passes a location
# string — the offending block's own `location`, or the literal "document" for
# a document-wide shortfall (a missing foundation kind names no single block).
#
# Every vocabulary these rules test is interpolated from the schema-derived
# Python lists above, emitted as a Lua literal — NEVER hand-authored — so a
# schema change re-projects the rule to match.

def lua_str_list(values):
    # a Lua array literal of quoted strings, e.g. { "a", "b" }
    return "{ " + ", ".join('"%s"' % v for v in values) + " }"


def fill(template, **subs):
    # interpolate __NAME__ placeholders — NOT %-formatting, because rule bodies
    # contain literal Lua string patterns with % (e.g. %d for a digit) that a
    # %-format would misread. Placeholder substitution leaves them untouched.
    out = template
    for key, val in subs.items():
        out = out.replace("__%s__" % key, val)
    return out


# 1 · foundation order + cardinality
foundation_rule = (
    '-- Generated by scripts/richmd-project — do not hand-edit.\n'
    '-- Cross-block rule (richmd#0008): the foundation blocks (goal, no-goal,\n'
    '-- invariant, principle) appear in the schema-declared order, and the\n'
    '-- per-kind minimum holds (>=1 goal, invariant, principle). Order + kinds\n'
    '-- derive from schema/design-schema.json (foundation_cardinality /\n'
    '-- spine[0], cross-checked); this file is regenerated from them.\n'
    'local ORDER = __ORDER__\n'
    'local REQUIRED = __REQUIRED__\n'
    'local rank = {}\n'
    'for i, k in ipairs(ORDER) do rank[k] = i end\n'
    'return {\n'
    '  check = function(block_projections, add_error)\n'
    '    local seen_rank = 0\n'
    '    local prev_kind = nil\n'
    '    local counts = {}\n'
    '    local last_location = "document"\n'
    '    for _, p in ipairs(block_projections) do\n'
    '      local r = rank[p.kind]\n'
    '      if r ~= nil then\n'
    '        last_location = p.location\n'
    '        counts[p.kind] = (counts[p.kind] or 0) + 1\n'
    '        if r < seen_rank then\n'
    '          add_error(\n'
    '            "rule:foundation-order-and-cardinality",\n'
    '            p.location,\n'
    '            "foundation kind \'" .. p.kind .. "\' appears after \'"\n'
    '              .. tostring(prev_kind) .. "\' — section 00 orders its kinds "\n'
    '              .. table.concat(ORDER, " -> ")\n'
    '          )\n'
    '        else\n'
    '          seen_rank = r\n'
    '          prev_kind = p.kind\n'
    '        end\n'
    '      end\n'
    '    end\n'
    '    -- cardinality only applies once the document HAS a foundation (any of\n'
    '    -- the ordered kinds present); a document with none is not a design\n'
    '    -- document this rule judges.\n'
    '    local any = false\n'
    '    for _, k in ipairs(ORDER) do if counts[k] then any = true end end\n'
    '    if not any then return end\n'
    '    for _, k in ipairs(REQUIRED) do\n'
    '      if (counts[k] or 0) == 0 then\n'
    '        add_error(\n'
    '          "rule:foundation-order-and-cardinality",\n'
    '          last_location,\n'
    '          "the foundation requires at least one \'" .. k .. "\' block"\n'
    '        )\n'
    '      end\n'
    '    end\n'
    '  end,\n'
    '}\n'
)
foundation_rule = fill(
    foundation_rule,
    ORDER=lua_str_list(foundation_order),
    REQUIRED=lua_str_list([k for k in foundation_order
                           if k in ("goal", "invariant", "principle")]),
)


# 2 · pending-entry validity
#
# The ADR check matches the in-house validator's strictness: a build entry must
# carry an actual LINK whose href fragment is `#adr-NNNN`, not merely visible
# text reading "ADR-NNNN". richmd's block projection now exposes `links` — a
# list of `{ text, target }` where target is the resolved href including the
# `#fragment` (richmd#21) — so the rule inspects the resolved target fragment,
# not the flattened body_text. A self-link (a pending block that links only to
# its own anchor) does not count: the fragment must match `#adr-NNNN`.
pending_rule = (
    '-- Generated by scripts/richmd-project — do not hand-edit.\n'
    '-- Cross-block rule (richmd#0008): each pending block carries a valid kind\n'
    '-- and a YYYY-MM-DD since, and a build entry cites an ADR. kind vocabulary\n'
    '-- derives from schema.pending_ledger.kinds; regenerated from the schema.\n'
    '--\n'
    '-- The ADR citation is checked against the block\'s LINKS (richmd#21): a\n'
    '-- build entry must carry a link whose resolved target fragment matches\n'
    '-- `#adr-NNNN` — an actual link, not merely visible text. This matches the\n'
    '-- in-house validator\'s href-fragment strictness.\n'
    'local KINDS = __KINDS__\n'
    'local kind_ok = {}\n'
    'for _, k in ipairs(KINDS) do kind_ok[k] = true end\n'
    'return {\n'
    '  check = function(block_projections, add_error)\n'
    '    for _, p in ipairs(block_projections) do\n'
    '      if p.kind == "pending" then\n'
    '        local k = p.attrs and p.attrs.kind\n'
    '        if not k or not kind_ok[k] then\n'
    '          add_error(\n'
    '            "rule:pending-entry-validity",\n'
    '            p.location,\n'
    '            "pending kind \'" .. tostring(k) .. "\' — kind is required and "\n'
    '              .. "one of " .. table.concat(KINDS, ", ")\n'
    '          )\n'
    '        end\n'
    '        local since = p.attrs and p.attrs.since\n'
    '        if not since or not string.match(since, "^%d%d%d%d%-%d%d%-%d%d$") then\n'
    '          add_error(\n'
    '            "rule:pending-entry-validity",\n'
    '            p.location,\n'
    '            "pending since \'" .. tostring(since) .. "\' — since is required "\n'
    '              .. "as YYYY-MM-DD"\n'
    '          )\n'
    '        end\n'
    '        if k == "build" then\n'
    '          local cited = false\n'
    '          for _, link in ipairs(p.links or {}) do\n'
    '            local target = link.target or ""\n'
    '            if string.match(string.lower(target), "#adr%-%d%d%d%d") then\n'
    '              cited = true\n'
    '            end\n'
    '          end\n'
    '          if not cited then\n'
    '            add_error(\n'
    '              "rule:pending-entry-validity",\n'
    '              p.location,\n'
    '              "pending build entry must cite its ADR (a link whose target "\n'
    '                .. "fragment is #adr-NNNN)"\n'
    '            )\n'
    '          end\n'
    '        end\n'
    '      end\n'
    '    end\n'
    '  end,\n'
    '}\n'
)
pending_rule = fill(pending_rule, KINDS=lua_str_list(pending_kinds))


# 3 · invariant enforcement enum + mechanism/partial names a script
#
# The in-house validator required a script for BOTH mechanism AND partial (a
# partial names the script checking its mechanical shadow); it is derived from
# the enforcement vocabulary here the same way. The enum members come from
# schema.enums.enforcement.values.
enforcement_rule = (
    '-- Generated by scripts/richmd-project — do not hand-edit.\n'
    '-- Cross-block rule (richmd#0008): an invariant block\'s enforcement attr\n'
    '-- is one of the schema enforcement values, and a mechanism/partial\n'
    '-- invariant names a script. The enum derives from\n'
    '-- schema.enums.enforcement.values; regenerated from the schema.\n'
    'local ENFORCEMENT = __ENFORCEMENT__\n'
    'local NAMES_SCRIPT = __NAMES_SCRIPT__\n'
    'local enf_ok = {}\n'
    'for _, e in ipairs(ENFORCEMENT) do enf_ok[e] = true end\n'
    'local needs_script = {}\n'
    'for _, e in ipairs(NAMES_SCRIPT) do needs_script[e] = true end\n'
    'return {\n'
    '  check = function(block_projections, add_error)\n'
    '    for _, p in ipairs(block_projections) do\n'
    '      if p.kind == "invariant" then\n'
    '        local e = p.attrs and p.attrs.enforcement\n'
    '        if not e or not enf_ok[e] then\n'
    '          add_error(\n'
    '            "rule:invariant-enforcement",\n'
    '            p.location,\n'
    '            "invariant enforcement \'" .. tostring(e) .. "\' — required and "\n'
    '              .. "one of " .. table.concat(ENFORCEMENT, ", ")\n'
    '          )\n'
    '        elseif needs_script[e] and not (p.attrs and p.attrs.script) then\n'
    '          add_error(\n'
    '            "rule:invariant-enforcement",\n'
    '            p.location,\n'
    '            "invariant enforcement=" .. e .. " without a script — a " .. e\n'
    '              .. " invariant names the script that decides it (script=<name>)"\n'
    '          )\n'
    '        end\n'
    '      end\n'
    '    end\n'
    '  end,\n'
    '}\n'
)
enforcement_rule = fill(
    enforcement_rule,
    ENFORCEMENT=lua_str_list(enforcement_values),
    NAMES_SCRIPT=lua_str_list(
        [e for e in enforcement_values if e in ("mechanism", "partial")]),
)


# 4 · lens `+` combo on a block attr
#
# richmd resolves single inline `lens:<member>` spans against tokens/lens.json
# natively, but it does NOT split a `+` combo (richmd#0011 rejected combinators):
# a `lens=a+b` block ATTR is a plain string richmd never token-validates. The
# in-house validator split `lens=` on `+` and checked each part is a valid lens
# with no duplicate. This rule reproduces exactly that for the lens attr, over
# the same schema-derived lens vocabulary. (A single non-combo `lens:` span in
# PROSE stays richmd's own token check; this rule adds only the attr `+` combo.)
lens_combo_rule = (
    '-- Generated by scripts/richmd-project — do not hand-edit.\n'
    '-- Cross-block rule (richmd#0008): a `lens=` block attr may name a `+`\n'
    '-- combo of lens members; each part must be a valid lens with no\n'
    '-- duplicate. richmd validates single inline `lens:` spans natively but\n'
    '-- never splits a `+` combo, and never validates a `lens=` attr at all,\n'
    '-- so the attr combo is checked here. The lens set derives from\n'
    '-- schema.enums.lens.values; regenerated from the schema.\n'
    'local LENSES = __LENSES__\n'
    'local lens_ok = {}\n'
    'for _, l in ipairs(LENSES) do lens_ok[l] = true end\n'
    'return {\n'
    '  check = function(block_projections, add_error)\n'
    '    for _, p in ipairs(block_projections) do\n'
    '      local raw = p.attrs and p.attrs.lens\n'
    '      if raw ~= nil then\n'
    '        local seen = {}\n'
    '        for part in string.gmatch(raw, "[^+]+") do\n'
    '          if not lens_ok[part] then\n'
    '            add_error(\n'
    '              "rule:lens-combo",\n'
    '              p.location,\n'
    '              "unknown lens \'" .. part .. "\' in lens= attr — lenses: "\n'
    '                .. table.concat(LENSES, ", ")\n'
    '            )\n'
    '          elseif seen[part] then\n'
    '            add_error(\n'
    '              "rule:lens-combo",\n'
    '              p.location,\n'
    '              "duplicate lens \'" .. part .. "\' in lens= combo"\n'
    '            )\n'
    '          else\n'
    '            seen[part] = true\n'
    '          end\n'
    '        end\n'
    '      end\n'
    '    end\n'
    '  end,\n'
    '}\n'
)
lens_combo_rule = fill(lens_combo_rule, LENSES=lua_str_list(lens_values))


# title-length rule: every TITLED block (the statement family + pending) carries
# a title= attr of at most 64 chars. Presence is enforced by the block schema
# (title is required); this rule enforces the length cap the statement_blocks
# contract declares. Plainness/no-links is automatic — an attr value is always a
# plain string and cannot carry markdown. The titled-kind set is derived from
# the schema (the blocks that declare a required title attr).
title_length_rule = (
    '-- Generated by scripts/richmd-project — do not hand-edit.\n'
    '-- Cross-block rule: a titled block\'s title= attr is at most 64 chars\n'
    '-- (the statement_blocks contract cap). Presence + type are enforced by the\n'
    '-- block schema; this rule adds the length cap. Titled kinds derive from the\n'
    '-- schema (blocks declaring a required title attr).\n'
    'local TITLED = __TITLED__\n'
    'local titled_ok = {}\n'
    'for _, k in ipairs(TITLED) do titled_ok[k] = true end\n'
    'return {\n'
    '  check = function(block_projections, add_error)\n'
    '    for _, p in ipairs(block_projections) do\n'
    '      if titled_ok[p.kind] then\n'
    '        local t = p.attrs and p.attrs.title\n'
    '        if t and utf8 and utf8.len and utf8.len(t) and utf8.len(t) > 64 then\n'
    '          add_error(\n'
    '            "rule:title-length",\n'
    '            p.location,\n'
    '            "title is " .. tostring(utf8.len(t)) .. " chars — the "\n'
    '              .. p.kind .. " title= must be at most 64"\n'
    '          )\n'
    '        end\n'
    '      end\n'
    '    end\n'
    '  end,\n'
    '}\n'
)
# titled kinds = every block whose schema declares a required title attr
_titled_kinds = sorted(
    k for k, spec in blocks.items()
    if "title" in spec["attrs"] and spec["attrs"]["title"].get("required")
)
title_length_rule = fill(title_length_rule, TITLED=lua_str_list(_titled_kinds))


# behavior-clauses rule: the clause blocks (given/when/then) are legal ONLY
# nested inside a behavior block, in the fixed order given→when→then, with the
# cardinality the behavior_contract declares (given 0..n, when exactly 1, then
# 1..n). A block schema cannot express nesting, order, or counts, so this is a
# cross-block rule. Every bound is READ from the schema, never literal here.
behavior_clauses_rule = (
    '-- Generated by scripts/richmd-project — do not hand-edit.\n'
    '-- Cross-block rule: behavior clause structure. The clause kinds are legal\n'
    '-- only inside a behavior block; order is fixed; cardinality is declared in\n'
    '-- design_doc.behavior_contract.clause_cardinality.\n'
    '-- NOTE: `then` is a reserved Lua keyword, so every table key naming the\n'
    '-- then-clause uses bracket syntax ["then"], never bare then=.\n'
    'local CLAUSES = { "given", "when", "then" }\n'
    'local ORDER = { given = 1, when = 2, ["then"] = 3 }\n'
    'local is_clause = {}\n'
    'for _, k in ipairs(CLAUSES) do is_clause[k] = true end\n'
    'return {\n'
    '-- The projection is DEPTH-FIRST POST-ORDER: a nested clause is emitted\n'
    '-- BEFORE its enclosing behavior block. So clauses accumulate into a pending\n'
    '-- run, and the next behavior block claims that run as its children. Any\n'
    '-- other block kind between them ends the run, orphaning those clauses.\n'
    '  check = function(block_projections, add_error)\n'
    '    local pending = {}\n'
    '    local function orphan_all()\n'
    '      for _, c in ipairs(pending) do\n'
    '        add_error(\n'
    '          "rule:behavior-clauses",\n'
    '          c.location,\n'
    '          "a " .. c.kind .. " clause is legal only nested inside a"\n'
    '            .. " behavior block"\n'
    '        )\n'
    '      end\n'
    '      pending = {}\n'
    '    end\n'
    '    for _, p in ipairs(block_projections) do\n'
    '      if is_clause[p.kind] then\n'
    '        table.insert(pending, p)\n'
    '      elseif p.kind == "behavior" then\n'
    '        local counts = { given = 0, when = 0, ["then"] = 0 }\n'
    '        local last_rank = 0\n'
    '        for _, c in ipairs(pending) do\n'
    '          counts[c.kind] = counts[c.kind] + 1\n'
    '          local rank = ORDER[c.kind]\n'
    '          if rank < last_rank then\n'
    '            add_error(\n'
    '              "rule:behavior-clauses",\n'
    '              c.location,\n'
    '              "clause order is fixed given -> when -> then; a " .. c.kind\n'
    '                .. " clause appears after a later clause"\n'
    '            )\n'
    '          end\n'
    '          last_rank = rank\n'
    '        end\n'
    '        if counts.when ~= 1 then\n'
    '          add_error(\n'
    '            "rule:behavior-clauses",\n'
    '            p.location,\n'
    '            "behavior rule has " .. tostring(counts.when)\n'
    '              .. " when clause(s) — exactly one is required (two events"\n'
    '              .. " are two rules)"\n'
    '          )\n'
    '        end\n'
    '        if counts["then"] < 1 then\n'
    '          add_error(\n'
    '            "rule:behavior-clauses",\n'
    '            p.location,\n'
    '            "behavior rule has no then clause — at least one observable"\n'
    '              .. " outcome is required"\n'
    '          )\n'
    '        end\n'
    '        pending = {}\n'
    '      else\n'
    '        orphan_all()\n'
    '      end\n'
    '    end\n'
    '    orphan_all()\n'
    '  end,\n'
    '}\n'
)

# behavior-fence rule: the per-level mechanism denylist. Enforcement is PARTIAL
# by declaration — a denylist catches "#submit-btn" and misses "the blue button
# in the top right" — so this raises the floor without claiming a proof. The
# term lists are READ from design_doc.behavior_contract.fence.
behavior_fence_rule = (
    '-- Generated by scripts/richmd-project — do not hand-edit.\n'
    '-- Cross-block rule: the behavior fence. A clause must not name the\n'
    '-- mechanism; the forbidden vocabulary is per-level and declared in\n'
    '-- design_doc.behavior_contract.fence. PARTIAL enforcement by design: a\n'
    '-- denylist raises the floor, the reviewer catches the rest.\n'
    'local FENCE = __FENCE__\n'
    'local is_clause = { given = true, when = true, ["then"] = true }\n'
    '-- clause text: the block body flattened to a lowercase string\n'
    'local function body_text(p)\n'
    '  return string.lower(p.body_text or "")\n'
    'end\n'
    '-- The projection is DEPTH-FIRST POST-ORDER: a clause is emitted BEFORE the\n'
    '-- behavior block that encloses it, so the enclosing level= is not known yet\n'
    '-- when the clause is seen. Clauses therefore accumulate into a pending run,\n'
    '-- and the fence is applied when the behavior block arrives and supplies the\n'
    '-- level. Orphan clauses (no behavior parent) are the clause rule\'s finding,\n'
    '-- not the fence\'s — the fence stays silent on them.\n'
    'return {\n'
    '  check = function(block_projections, add_error)\n'
    '    local pending = {}\n'
    '    for _, p in ipairs(block_projections) do\n'
    '      if is_clause[p.kind] then\n'
    '        table.insert(pending, p)\n'
    '      elseif p.kind == "behavior" then\n'
    '        local level = p.attrs and p.attrs.level\n'
    '        if level and FENCE[level] then\n'
    '          for _, c in ipairs(pending) do\n'
    '            local text = body_text(c)\n'
    '            -- id/selector SHAPES first: matched as Lua patterns against\n'
    '            -- the ORIGINAL-case body, since an id is case-sensitive.\n'
    '            for _, pat in ipairs(FENCE[level].patterns) do\n'
    '              local hit = string.match(c.body_text or "", pat)\n'
    '              if hit then\n'
    '                add_error(\n'
    '                  "rule:behavior-fence",\n'
    '                  c.location,\n'
    '                  "this " .. c.kind .. " clause names an implementation"\n'
    '                    .. " identifier (\\"" .. hit .. "\\") in a level="\n'
    '                    .. level .. " rule — state the observable outcome"\n'
    '                    .. " instead. The test: will this wording need to"\n'
    '                    .. " change if the implementation does?"\n'
    '                )\n'
    '              end\n'
    '            end\n'
    '            for _, term in ipairs(FENCE[level].terms) do\n'
    '              if string.find(text, term, 1, true) then\n'
    '                add_error(\n'
    '                  "rule:behavior-fence",\n'
    '                  c.location,\n'
    '                  "this " .. c.kind .. " clause names the mechanism (\\""\n'
    '                    .. term .. "\\") in a level=" .. level .. " rule —"\n'
    '                    .. " state the observable outcome instead. The test:"\n'
    '                    .. " will this wording need to change if the"\n'
    '                    .. " implementation does?"\n'
    '                )\n'
    '              end\n'
    '            end\n'
    '          end\n'
    '        end\n'
    '        pending = {}\n'
    '      else\n'
    '        pending = {}\n'
    '      end\n'
    '    end\n'
    '  end,\n'
    '}\n'
)


# The fence tables are built ENTIRELY from behavior_fence, which was read from
# the schema above — there is no local term list. Each level gets its literal
# substrings and its Lua patterns; a schema edit to either array re-projects
# this rule, which is the property the previous hardcoded table silently broke.
def _fence_level_lua(spec):
    return (
        "{ terms = %s, patterns = %s }"
        % (lua_str_list(spec["terms"]), lua_str_list(spec["patterns"]))
    )


_fence_lua = (
    "{\n"
    + "".join(
        '  ["%s"] = %s,\n' % (lv, _fence_level_lua(behavior_fence[lv]))
        for lv in behavior_levels
    )
    + "}"
)
behavior_fence_rule = fill(behavior_fence_rule, FENCE=_fence_lua)

rules = {
    "foundation-order-and-cardinality": foundation_rule,
    "pending-entry-validity": pending_rule,
    "invariant-enforcement": enforcement_rule,
    "lens-combo": lens_combo_rule,
    "title-length": title_length_rule,
    "behavior-clauses": behavior_clauses_rule,
    "behavior-fence": behavior_fence_rule,
}
rules_written = []
for name in sorted(rules.keys()):
    try:
        with open(os.path.join(rules_dir, "%s.lua" % name), "w", encoding="utf-8") as f:
            f.write(rules[name])
    except OSError as e:
        sys.stderr.write("richmd-project: error: cannot write rule %s: %s\n" % (name, e))
        sys.exit(2)
    rules_written.append(name)


# ---------------------------------------------------------------- shell hook
# shell/shell.lua — the document-shell hook (richmd#25 / ADR-0023): the 4th
# consumer-declarable contract, a render-phase module returning
# `{ masthead = function(doc_meta) -> pandoc.Blocks, colophon = ... }`. richmd
# prepends the masthead and appends the colophon inside `.richmd-container`.
#
# The hook renders the page-identity frontmatter the schema declares under
# design_doc.frontmatter_keys — NEVER a hardcoded key list. The three keys map
# to two regions by their fixed role (masthead: eyebrow, lede; colophon:
# footer); the mapping below is filtered to the keys the schema actually
# declares, so each emitted region reads exactly the schema-sourced key names
# and a schema edit to the key set re-projects the hook. Each region reads the
# RAW metavalue (doc.meta[key]) and turns it into inline content WITHOUT
# stringifying — so a value's inline markdown (an eyebrow's `[root](...)` link,
# a lede's `**bold**`) is preserved (richmd hands the region the raw metavalue
# tree, as container_classes reads it). A missing key yields nil and injects
# nothing; a region with no content returns nil (richmd treats nil as "inject
# nothing"). Output is deterministic and luac-clean; the file carries the
# do-not-hand-edit header.
#
# ROLE MAP — fixed per key (owner-decided, ADR-0023): the eyebrow is a kicker
# line, the lede a muted `.richmd-lede` paragraph, the footer a colophon block.
# The renderer helper each key uses is chosen by role, but the KEY NAME itself
# is the schema string.
_SHELL_MASTHEAD_KEYS = ["eyebrow", "hero_title", "lede"]
_SHELL_COLOPHON_KEYS = ["footer"]
# emit only keys the schema declares (fail-closed drift check above already
# guarantees eyebrow/lede/footer are present; this filter keeps the emission
# strictly schema-sourced rather than literal).
masthead_keys = [k for k in _SHELL_MASTHEAD_KEYS if k in frontmatter_keys]
colophon_keys = [k for k in _SHELL_COLOPHON_KEYS if k in frontmatter_keys]


def _shell_eyebrow_piece(key):
    # eyebrow -> a .richmd-eyebrow kicker Div (a distinct richmd-* region
    # element), inline links preserved.
    return (
        '    do\n'
        '      local inlines = meta_to_inlines(doc_meta and doc_meta[%r])\n'
        '      if inlines then\n'
        '        table.insert(\n'
        '          out,\n'
        '          pandoc.Div(\n'
        '            { pandoc.Plain(inlines) },\n'
        '            pandoc.Attr("", { "richmd-eyebrow" })\n'
        '          )\n'
        '        )\n'
        '      end\n'
        '    end\n'
    ) % key


def _shell_lede_piece(key):
    # lede -> a muted paragraph carrying richmd's shipped .richmd-lede class. A
    # real <p class="richmd-lede"> is emitted via the same RawBlock bracket the
    # statement renderer uses (a Para carries no Attr in pandoc), inline markup
    # preserved between the markers.
    return (
        '    do\n'
        '      local inlines = meta_to_inlines(doc_meta and doc_meta[%r])\n'
        '      if inlines then\n'
        '        table.insert(out, pandoc.RawBlock("html", \'<p class="richmd-lede">\'))\n'
        '        table.insert(out, pandoc.Plain(inlines))\n'
        '        table.insert(out, pandoc.RawBlock("html", "</p>"))\n'
        '      end\n'
        '    end\n'
    ) % key


def _shell_footer_piece(key):
    # footer -> a .richmd-colophon block (a distinct richmd-* region element),
    # inline links preserved.
    return (
        '    do\n'
        '      local inlines = meta_to_inlines(doc_meta and doc_meta[%r])\n'
        '      if inlines then\n'
        '        table.insert(\n'
        '          out,\n'
        '          pandoc.Div(\n'
        '            { pandoc.Plain(inlines) },\n'
        '            pandoc.Attr("", { "richmd-colophon" })\n'
        '          )\n'
        '        )\n'
        '      end\n'
        '    end\n'
    ) % key


def _shell_hero_title_piece(key):
    # hero_title -> the page's display H1, emitted inside the hero copy column
    # (the document body carries no top-level H1 when hero_title is set). A real
    # pandoc.Header(1, ...) so richmd's heading machinery and the overlay's
    # .richmd-hero-grid h1 styling both apply; inline markup preserved.
    return (
        '    do\n'
        '      local inlines = meta_to_inlines(doc_meta and doc_meta[%r])\n'
        '      if inlines then\n'
        '        table.insert(out, pandoc.Header(1, inlines))\n'
        '      end\n'
        '    end\n'
    ) % key


_SHELL_PIECE = {
    "eyebrow": _shell_eyebrow_piece,
    "hero_title": _shell_hero_title_piece,
    "lede": _shell_lede_piece,
    "footer": _shell_footer_piece,
}


def _shell_region(region_name, keys, with_style=False):
    # a region function: build `out` from each key's piece, return nil when
    # empty (richmd injects nothing) so a doc missing all of a region's keys is
    # nil-safe. When `with_style` (the masthead), the region:
    #   1. prepends the semantic-look overlay <style> (ADR-0024) + the Fraunces
    #      fonts <link> — both must ship on EVERY rendered document, so the
    #      masthead always returns a non-empty Blocks list;
    #   2. wraps the page-identity pieces (eyebrow · hero_title · lede) in a
    #      two-column hero: .richmd-hero-grid > .richmd-hero-copy (the pieces) +
    #      the fixpoint mark. The overlay styles the grid.
    body = (
        "  %s = function(doc_meta)\n"
        "    local out = {}\n" % region_name
    )
    if with_style:
        body += "    table.insert(out, style_block())\n"
        body += "    table.insert(out, fonts_block())\n"
        body += (
            "    table.insert(out, pandoc.RawBlock(\"html\", "
            "'<div class=\"richmd-hero-grid\"><div class=\"richmd-hero-copy\">'))\n"
        )
    for key in keys:
        body += _SHELL_PIECE[key](key)
    if with_style:
        # close the copy column, add the fixpoint mark, close the grid
        body += "    table.insert(out, pandoc.RawBlock(\"html\", '</div>'))\n"
        body += "    table.insert(out, fixpoint_block())\n"
        body += "    table.insert(out, pandoc.RawBlock(\"html\", '</div>'))\n"
    body += (
        "    if #out == 0 then return nil end\n"
        "    return pandoc.Blocks(out)\n"
        "  end,\n"
    )
    return body


# meta_to_inlines — turn a raw doc.meta value into a pandoc.Inlines list WITHOUT
# stringifying, so inline markdown (links, bold) survives. richmd hands a
# frontmatter scalar as either a MetaInlines value (an ipairs-iterable list of
# Inline elements — the case whenever the value carries markdown) or, for a
# bare scalar, a plain Lua string; both are handled. An empty/absent value
# yields nil, which the region treats as "omit this piece".
_SHELL_HELPER = (
    "local function meta_to_inlines(v)\n"
    "  if v == nil then return nil end\n"
    "  if type(v) == \"string\" then\n"
    "    if v == \"\" then return nil end\n"
    "    return pandoc.Inlines({ pandoc.Str(v) })\n"
    "  end\n"
    "  if type(v) == \"table\" then\n"
    "    local inlines = {}\n"
    "    for _, el in ipairs(v) do table.insert(inlines, el) end\n"
    "    if #inlines == 0 then return nil end\n"
    "    return pandoc.Inlines(inlines)\n"
    "  end\n"
    "  return nil\n"
    "end\n"
)

# ---------------------------------------------------------- semantic overlay
# The framework's SEMANTIC-LOOK overlay (ADR-0024): richmd owns the BASE look
# (typography, layout, spacing, base classes); the framework owns the SEMANTIC
# look — the per-kind statement accent, the per-lens pill palette, the card
# tints — because those encode the design's OWN vocabulary (the four statement
# kinds, the lens enum, the accent tints), which a generic renderer cannot
# supply. richmd exposes no consumer-stylesheet input, so the overlay is
# DELIVERED as a projected `<style>` block through the document-shell hook
# (ADR-0023 / richmd#25): the masthead region prepends it ahead of the page
# chrome.
#
# The overlay OVERRIDES CLEANLY: where it takes over a property richmd's base
# already sets on .richmd-statement (display:grid, grid-template-columns,
# padding, border-top) or .richmd-card (border, background, border-radius,
# padding, box-shadow), it RESETS then restyles so richmd's value is replaced,
# never stacked — no double borders or competing backgrounds.
#
# Every enumerated vocabulary here is SCHEMA-DERIVED — the four statement kinds
# (foundation_kinds), the lens list (enums.lens.values), the tint list
# (design_doc.accents.values), the enforcement values (enums.enforcement.values)
# — so a schema mutation (a new lens or tint) reprojects the overlay to match,
# the same discipline as every other projected artifact. A member with no entry
# in the reference palette (e.g. a freshly added lens) gets a neutral fallback
# so the projection never crashes; the reference palette below is the
# framework's chosen look, recovered from the retired design-style.css asset.

# reference palettes — the framework's chosen semantic look (retired
# design-style.css, re-expressed over richmd's classes). Keyed by the schema's
# own member names; light + dark oklch pairs.
_LENS_PALETTE = {
    # lens: (light-bg, light-fg, dark-bg, dark-fg)
    "modeling":    ("oklch(92% 0.05 130)", "oklch(38% 0.1 130)",  "oklch(30% 0.06 130)", "oklch(85% 0.08 130)"),
    "depth":       ("oklch(92% 0.05 275)", "oklch(38% 0.11 275)", "oklch(30% 0.06 275)", "oklch(84% 0.07 275)"),
    "composition": ("oklch(91% 0.05 185)", "oklch(34% 0.08 185)", "oklch(27% 0.05 185)", "oklch(82% 0.07 185)"),
    "state":       ("oklch(92% 0.045 315)", "oklch(38% 0.1 315)", "oklch(29% 0.06 315)", "oklch(84% 0.07 315)"),
    "invariants":  ("oklch(93% 0.06 80)",  "oklch(40% 0.1 65)",   "oklch(30% 0.06 75)",  "oklch(85% 0.08 75)"),
    "robustness":  ("oklch(92% 0.05 20)",  "oklch(42% 0.11 15)",  "oklch(29% 0.055 20)", "oklch(84% 0.07 20)"),
}
_TINT_PALETTE = {
    # tint: (light-bg, light-fg, light-edge, dark-bg, dark-fg, dark-edge)
    "teal":   ("oklch(94% 0.035 185)", "oklch(34% 0.08 185)", "oklch(70% 0.09 185)", "oklch(26% 0.04 185)", "oklch(82% 0.07 185)", "oklch(45% 0.08 185)"),
    "violet": ("oklch(94% 0.035 300)", "oklch(38% 0.1 300)",  "oklch(70% 0.1 300)",  "oklch(27% 0.045 300)", "oklch(83% 0.07 300)", "oklch(48% 0.09 300)"),
    "amber":  ("oklch(94% 0.045 75)",  "oklch(40% 0.1 65)",   "oklch(75% 0.11 70)",  "oklch(28% 0.05 75)",  "oklch(85% 0.08 75)",  "oklch(55% 0.1 70)"),
    "blue":   ("oklch(94% 0.03 245)",  "oklch(38% 0.09 245)", "oklch(70% 0.08 245)", "oklch(26% 0.035 245)", "oklch(82% 0.06 245)", "oklch(46% 0.07 245)"),
    "rose":   ("oklch(94% 0.03 15)",   "oklch(42% 0.11 15)",  "oklch(72% 0.1 15)",   "oklch(26% 0.035 15)", "oklch(84% 0.07 15)",  "oklch(48% 0.08 15)"),
    "slate":  ("oklch(94% 0.006 75)",  "oklch(38% 0.012 75)", "oklch(87% 0.008 75)", "oklch(25% 0.008 75)", "oklch(80% 0.008 75)", "oklch(38% 0.012 75)"),
}
# per-kind statement accent edge — a quiet left edge, one hue per kind. Maps a
# statement kind to a tint identity (goal->teal, no-goal->rose, principle->
# violet, invariant->amber), the same pairing the retired asset used. `behavior`
# joins as a block kind rather than a foundation kind: the accent's axis is
# "which block kind", and blue is the one tint no other kind claims, so a
# behavior rule is identifiable at a glance without colliding with principle.
_KIND_TINT = {
    "goal": "teal", "no-goal": "rose", "principle": "violet", "invariant": "amber",
    "behavior": "blue",
}
# the block kinds carrying a per-kind statement accent = the foundation kinds
# plus `behavior`. Kept as its own list because foundation_kinds is validated
# for order and cardinality (a behavior rule is not part of the foundation),
# while the accent ranges over every kind with a tint identity.
_ACCENTED_KINDS = ["behavior"]
# clause keyword tone — one per clause kind, so a reader identifies the clause
# before reading it. `given` stays recessive (it sets the stage), `when` is the
# warm accent (the one event), `then` reads as the outcome. All three are kept
# clear of the behavior block's own blue edge so no two elements read as the
# same axis.
_CLAUSE_TINT = {"given": "slate", "when": "amber", "then": "teal"}
# clause-keyword ink — its own light/dark pair per clause kind, NOT the tint's
# `-fg`. The tint foregrounds all sit near oklch(0.38-0.40) lightness, so on a
# light ground the three keywords read as similar dark ink and the hue is lost;
# the same values read clearly in dark mode, where they invert to ~0.85. These
# push the light values apart in both chroma and lightness so the three
# separate on a pale ground, and keep the tint's dark values, which already
# work.
_CLAUSE_KEYWORD_INK = {
    # kind: (light, dark)
    "given": ("oklch(52% 0.014 75)", "oklch(70% 0.01 75)"),
    "when": ("oklch(52% 0.16 55)", "oklch(84% 0.11 70)"),
    "then": ("oklch(45% 0.11 185)", "oklch(82% 0.09 185)"),
}
# per-level badge tone — the `level=` chip carried its base neutral grey, which
# rendered `interface` and `boundary` identically. Each level takes its own tone
# the same way an enforcement value does.
_LEVEL_TINT = {"boundary": "violet"}
# level badge palette, where a level needs a hue no shared tint supplies.
# `interface` cannot reuse `blue`: the behavior block's own ground IS
# --fw-tint-blue-bg, so a blue chip resolves to the identical color as the
# card behind it and disappears. It takes hue 155 — the widest free gap in the
# wheel, between modeling-green (130) and teal (185), and far from the blue
# ground (245) and from `boundary` violet (300). Declared here rather than as a
# seventh shared tint because it answers one contrast problem, not a new
# ownership axis; `boundary` keeps the shared violet, which already contrasts.
_LEVEL_PALETTE = {
    # level: (light-bg, light-fg, dark-bg, dark-fg)
    "interface": ("oklch(93% 0.05 155)", "oklch(38% 0.09 155)",
                  "oklch(28% 0.055 155)", "oklch(84% 0.08 155)"),
}
# the behavior card's own ground — NOT --fw-tint-blue-bg, which the info
# callout and every `tint=blue` card grid also read; changing that would move
# them too. In light mode it is a much paler wash than the shared tint
# (97% vs 94% lightness, half the chroma) so the card reads as a quiet ground
# under the text rather than a saturated panel. The dark value keeps the
# shared tint's depth, which already reads well.
_BEHAVIOR_GROUND = ("oklch(97.5% 0.014 245)", "oklch(26% 0.035 245)")
# per-pending-kind tone — drives BOTH the kind pill and the entry wrapper's
# dashed edge, so an entry's kind is readable from the card itself and not only
# from its pill.
_PENDING_TINT = {
    "build": "blue", "verify": "teal", "foundation": "violet", "ruling": "amber",
}
# enforcement chip palette (the .richmd-badge--neutral enforcement chip carries
# the enforcement word; the overlay gives each enforcement value its own tone).
_ENF_PALETTE = {
    "mechanism":  ("oklch(91% 0.06 150)", "oklch(35% 0.09 150)", "oklch(27% 0.055 150)", "oklch(82% 0.08 150)"),
    "partial":    ("oklch(93% 0.06 80)",  "oklch(40% 0.1 65)",   "oklch(30% 0.06 75)",   "oklch(85% 0.08 75)"),
    "convention": ("oklch(93% 0.007 75)", "oklch(52% 0.014 75)", "oklch(27% 0.008 75)",  "oklch(65% 0.01 75)"),
}
_NEUTRAL = ("oklch(93% 0.006 75)", "oklch(45% 0.012 75)", "oklch(28% 0.009 75)", "oklch(70% 0.01 75)")
_NEUTRAL_EDGE = ("oklch(87% 0.008 75)", "oklch(38% 0.012 75)")


def _lens_vars(dark):
    lines = []
    for name in lens_values:
        p = _LENS_PALETTE.get(name)
        if p:
            bg, fg = (p[2], p[3]) if dark else (p[0], p[1])
        else:
            bg, fg = (_NEUTRAL[2], _NEUTRAL[3]) if dark else (_NEUTRAL[0], _NEUTRAL[1])
        lines.append("      --fw-lens-%s-bg: %s;" % (name, bg))
        lines.append("      --fw-lens-%s-fg: %s;" % (name, fg))
    return lines


def _tint_vars(dark):
    lines = []
    for name in tint_values:
        p = _TINT_PALETTE.get(name)
        if p:
            bg, fg, edge = (p[3], p[4], p[5]) if dark else (p[0], p[1], p[2])
        else:
            bg = _NEUTRAL[2] if dark else _NEUTRAL[0]
            fg = _NEUTRAL[3] if dark else _NEUTRAL[1]
            edge = _NEUTRAL_EDGE[1] if dark else _NEUTRAL_EDGE[0]
        lines.append("      --fw-tint-%s-bg: %s;" % (name, bg))
        lines.append("      --fw-tint-%s-fg: %s;" % (name, fg))
        lines.append("      --fw-tint-%s-edge: %s;" % (name, edge))
    return lines


def _behavior_ground_var(dark):
    # --fw-behavior-bg — the behavior card's own ground, kept separate from the
    # shared blue tint so the card can be paler than a tint=blue card grid.
    return ["      --fw-behavior-bg: %s;"
            % (_BEHAVIOR_GROUND[1] if dark else _BEHAVIOR_GROUND[0])]


def _level_vars(dark):
    # --fw-level-<level>-bg/-fg for any level with its own palette entry. A
    # level mapped to a shared tint instead emits nothing here and reads the
    # tint var directly.
    lines = []
    for name in behavior_levels:
        p = _LEVEL_PALETTE.get(name)
        if not p:
            continue
        bg, fg = (p[2], p[3]) if dark else (p[0], p[1])
        lines.append("      --fw-level-%s-bg: %s;" % (name, bg))
        lines.append("      --fw-level-%s-fg: %s;" % (name, fg))
    return lines


def _clause_ink_vars(dark):
    # --fw-clause-<kind>-ink, one per clause kind, from _CLAUSE_KEYWORD_INK.
    lines = []
    for name in _CLAUSE_KIND_ORDER:
        p = _CLAUSE_KEYWORD_INK.get(name)
        if not p:
            continue
        lines.append("      --fw-clause-%s-ink: %s;" % (name, p[1] if dark else p[0]))
    return lines


def _enf_vars(dark):
    lines = []
    for name in enforcement_values:
        p = _ENF_PALETTE.get(name)
        if p:
            bg, fg = (p[2], p[3]) if dark else (p[0], p[1])
        else:
            bg, fg = (_NEUTRAL[2], _NEUTRAL[3]) if dark else (_NEUTRAL[0], _NEUTRAL[1])
        lines.append("      --fw-enf-%s-bg: %s;" % (name, bg))
        lines.append("      --fw-enf-%s-fg: %s;" % (name, fg))
    return lines


def _kind_edge(name, dark):
    # the left-edge accent color for a statement kind = its paired tint's edge.
    tint = _KIND_TINT.get(name)
    p = _TINT_PALETTE.get(tint) if tint else None
    if p:
        return p[5] if dark else p[2]
    return _NEUTRAL_EDGE[1] if dark else _NEUTRAL_EDGE[0]


